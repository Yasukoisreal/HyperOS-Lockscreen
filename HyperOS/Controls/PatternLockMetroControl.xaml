<UserControl
    x:Class="HyperOS.Controls.PatternLockMetroControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="320" d:DesignWidth="320"
    MouseMove="UserControl_MouseMove"
    MouseLeftButtonDown="UserControl_MouseLeftButtonDown"
    MouseLeftButtonUp="UserControl_MouseLeftButtonUp">

    <Grid x:Name="LayoutRoot" Background="Transparent">
        <Canvas x:Name="PatternCanvas" Width="320" Height="320">
            <!-- 3x3 grid: centers at 60, 160, 260 (spacing=100, margin=60) -->
            <!-- Row 0 -->
            <Ellipse x:Name="Ring0" Width="52" Height="52" Fill="Transparent"
                     Stroke="Transparent" StrokeThickness="1.5"
                     Canvas.Left="34" Canvas.Top="34"/>
            <Ellipse x:Name="Dot0" Width="16" Height="16" Fill="#66FFFFFF"
                     Stroke="Transparent" StrokeThickness="0"
                     Canvas.Left="52" Canvas.Top="52"/>

            <Ellipse x:Name="Ring1" Width="52" Height="52" Fill="Transparent"
                     Stroke="Transparent" StrokeThickness="1.5"
                     Canvas.Left="134" Canvas.Top="34"/>
            <Ellipse x:Name="Dot1" Width="16" Height="16" Fill="#66FFFFFF"
                     Stroke="Transparent" StrokeThickness="0"
                     Canvas.Left="152" Canvas.Top="52"/>

            <Ellipse x:Name="Ring2" Width="52" Height="52" Fill="Transparent"
                     Stroke="Transparent" StrokeThickness="1.5"
                     Canvas.Left="234" Canvas.Top="34"/>
            <Ellipse x:Name="Dot2" Width="16" Height="16" Fill="#66FFFFFF"
                     Stroke="Transparent" StrokeThickness="0"
                     Canvas.Left="252" Canvas.Top="52"/>

            <!-- Row 1 -->
            <Ellipse x:Name="Ring3" Width="52" Height="52" Fill="Transparent"
                     Stroke="Transparent" StrokeThickness="1.5"
                     Canvas.Left="34" Canvas.Top="134"/>
            <Ellipse x:Name="Dot3" Width="16" Height="16" Fill="#66FFFFFF"
                     Stroke="Transparent" StrokeThickness="0"
                     Canvas.Left="52" Canvas.Top="152"/>

            <Ellipse x:Name="Ring4" Width="52" Height="52" Fill="Transparent"
                     Stroke="Transparent" StrokeThickness="1.5"
                     Canvas.Left="134" Canvas.Top="134"/>
            <Ellipse x:Name="Dot4" Width="16" Height="16" Fill="#66FFFFFF"
                     Stroke="Transparent" StrokeThickness="0"
                     Canvas.Left="152" Canvas.Top="152"/>

            <Ellipse x:Name="Ring5" Width="52" Height="52" Fill="Transparent"
                     Stroke="Transparent" StrokeThickness="1.5"
                     Canvas.Left="234" Canvas.Top="134"/>
            <Ellipse x:Name="Dot5" Width="16" Height="16" Fill="#66FFFFFF"
                     Stroke="Transparent" StrokeThickness="0"
                     Canvas.Left="252" Canvas.Top="152"/>

            <!-- Row 2 -->
            <Ellipse x:Name="Ring6" Width="52" Height="52" Fill="Transparent"
                     Stroke="Transparent" StrokeThickness="1.5"
                     Canvas.Left="34" Canvas.Top="234"/>
            <Ellipse x:Name="Dot6" Width="16" Height="16" Fill="#66FFFFFF"
                     Stroke="Transparent" StrokeThickness="0"
                     Canvas.Left="52" Canvas.Top="252"/>

            <Ellipse x:Name="Ring7" Width="52" Height="52" Fill="Transparent"
                     Stroke="Transparent" StrokeThickness="1.5"
                     Canvas.Left="134" Canvas.Top="234"/>
            <Ellipse x:Name="Dot7" Width="16" Height="16" Fill="#66FFFFFF"
                     Stroke="Transparent" StrokeThickness="0"
                     Canvas.Left="152" Canvas.Top="252"/>

            <Ellipse x:Name="Ring8" Width="52" Height="52" Fill="Transparent"
                     Stroke="Transparent" StrokeThickness="1.5"
                     Canvas.Left="234" Canvas.Top="234"/>
            <Ellipse x:Name="Dot8" Width="16" Height="16" Fill="#66FFFFFF"
                     Stroke="Transparent" StrokeThickness="0"
                     Canvas.Left="252" Canvas.Top="252"/>
        </Canvas>
    </Grid>
</UserControl>
