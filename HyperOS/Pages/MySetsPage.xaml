<phone:PhoneApplicationPage
    x:Class="HyperOS.Pages.MySetsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    SupportedOrientations="Portrait" Orientation="Portrait"
    shell:SystemTray.IsVisible="False"
    Loaded="Page_Loaded">

    <Grid Background="#111111">
        <!-- Header -->
        <Grid VerticalAlignment="Top" Margin="16,28,16,0" Canvas.ZIndex="10">
            <!-- Exit -->
            <Border HorizontalAlignment="Left" Background="#444444" CornerRadius="14" Padding="16,6" Tap="Exit_Tap">
                <TextBlock Text="Exit" FontSize="14" Foreground="White" FontFamily="/Assets/Fonts/MiSans-Demibold.ttf#MiSans"/>
            </Border>
            
            <Border Tap="Settings_Tap" HorizontalAlignment="Center"
                Width="40" Height="40" Background="Transparent">
                <TextBlock Text="⚙" FontSize="20" Foreground="#77FFFFFF"
                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            
            <!-- Apply -->
            <Border HorizontalAlignment="Right" Background="#3A7BF2" CornerRadius="14" Padding="16,6" Tap="Apply_Tap">
                <TextBlock Text="Apply" FontSize="14" Foreground="White" FontFamily="/Assets/Fonts/MiSans-Demibold.ttf#MiSans"/>
            </Border>
        </Grid>

        <!-- Title -->
        <StackPanel VerticalAlignment="Top" Margin="24,60,24,0" Canvas.ZIndex="10">
            <TextBlock x:Name="SetCategory" Text="CLASSIC"
                FontFamily="/Assets/Fonts/MiSans-Demibold.ttf#MiSans"
                FontSize="12" Foreground="#AAFFFFFF" HorizontalAlignment="Center"
                Margin="0,0,0,2"/>
            <TextBlock x:Name="SetTitle" Text="Classic"
                FontFamily="/Assets/Fonts/MiSans-Demibold.ttf#MiSans"
                FontSize="32" Foreground="White" HorizontalAlignment="Center"/>
            <TextBlock x:Name="SetSubtitle" Text=""
                FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"
                FontSize="13" Foreground="#77FFFFFF" HorizontalAlignment="Center"
                Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Carousel: Canvas for absolute positioning -->
        <Canvas x:Name="CarouselCanvas"
                Margin="0,150,0,100"
                Background="Transparent"
                ManipulationDelta="Carousel_ManipulationDelta"
                ManipulationCompleted="Carousel_ManipulationCompleted">
            <!-- Cards are added in code-behind as children of this Canvas -->
        </Canvas>

        <!-- Bottom -->
        <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,20" HorizontalAlignment="Center">
            <Border x:Name="CustomiseBtn" Tap="Customise_Tap"
                Background="#55FFFFFF" CornerRadius="22" Padding="36,10"
                Margin="0,0,0,14">
                <TextBlock Text="Customise"
                    FontFamily="/Assets/Fonts/MiSans-Demibold.ttf#MiSans"
                    FontSize="15" Foreground="White" HorizontalAlignment="Center"/>
            </Border>
            <StackPanel x:Name="DotsPanel" Orientation="Horizontal" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</phone:PhoneApplicationPage>
