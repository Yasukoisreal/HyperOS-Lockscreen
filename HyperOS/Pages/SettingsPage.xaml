<phone:PhoneApplicationPage
    x:Class="HyperOS.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:toolkit="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone.Controls.Toolkit"
    SupportedOrientations="Portrait" Orientation="Portrait"
    shell:SystemTray.IsVisible="False"
    Loaded="SettingsPage_Loaded">

    <Grid Background="#FF080810">
        <!-- Header -->
        <Grid VerticalAlignment="Top" Height="60" Margin="0,0,0,0" Canvas.ZIndex="10">
            <Grid.Background>
                <SolidColorBrush Color="#FF080810"/>
            </Grid.Background>
            <Border Tap="Back_Tap" Width="44" Height="44" Background="Transparent"
                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0">
                <TextBlock Text="◁" FontSize="22" Foreground="#AAFFFFFF"
                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Settings" FontSize="20" Foreground="White"
                FontFamily="/Assets/Fonts/MiSans-Demibold.ttf#MiSans"
                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="56,0,0,0"/>
        </Grid>

        <!-- Content -->
        <ScrollViewer Margin="0,60,0,0">
            <StackPanel Margin="20,12,20,40">

                <!-- LOCK SCREEN -->
                <TextBlock Text="LOCK SCREEN" FontSize="13" Foreground="#55FFFFFF"
                    FontFamily="/Assets/Fonts/MiSans-Demibold.ttf#MiSans" Margin="0,12,0,8"/>
                <Grid Background="#14FFFFFF" Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Use as live lockscreen" FontSize="15" Foreground="White"
                        FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"
                        VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <toolkit:ToggleSwitch x:Name="LockToggle" Grid.Column="1"
                        Checked="LockToggle_Changed" Unchecked="LockToggle_Changed"/>
                </Grid>

                <!-- SECURITY -->
                <TextBlock Text="SECURITY" FontSize="13" Foreground="#55FFFFFF"
                    FontFamily="/Assets/Fonts/MiSans-Demibold.ttf#MiSans" Margin="0,24,0,8"/>

                <!-- PIN Code -->
                <Grid Background="#14FFFFFF" Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="PIN Code Lock" FontSize="15" Foreground="White"
                        FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"
                        VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <toolkit:ToggleSwitch x:Name="PinToggle" Grid.Column="1"
                        Checked="PinToggle_Changed" Unchecked="PinToggle_Changed"/>
                </Grid>
                <StackPanel x:Name="PinPanel" Visibility="Collapsed" Margin="0,4,0,0">
                    <TextBox x:Name="PinBox" Background="#14FFFFFF" Foreground="White"
                        BorderThickness="0" FontSize="16" MaxLength="4"
                        FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"
                        InputScope="Number"/>
                    <Button Content="Save PIN" Click="SavePin_Click"
                        Background="#14FFFFFF" Foreground="#DDFFFFFF" BorderThickness="0"
                        FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans" FontSize="15"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Pattern Lock -->
                <Grid Background="#14FFFFFF" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Pattern Lock" FontSize="15" Foreground="White"
                        FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"
                        VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <toolkit:ToggleSwitch x:Name="PatternToggle" Grid.Column="1"
                        Checked="PatternToggle_Changed" Unchecked="PatternToggle_Changed"/>
                </Grid>
                <TextBlock x:Name="PatternHint" Text="" FontSize="12" Foreground="#88FFFFFF"
                    HorizontalAlignment="Center" Margin="0,4,0,0"
                    FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"/>

                <TextBlock x:Name="SecurityStatus" Text="" FontSize="12"
                    Foreground="#88FFFFFF" HorizontalAlignment="Center" Margin="0,8,0,0"
                    FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"/>

                <!-- OWNER INFO -->
                <TextBlock Text="OWNER INFO" FontSize="13" Foreground="#55FFFFFF"
                    FontFamily="/Assets/Fonts/MiSans-Demibold.ttf#MiSans" Margin="0,24,0,8"/>
                <TextBox x:Name="OwnerInfoBox" Background="#14FFFFFF" Foreground="White"
                    BorderThickness="0" FontSize="14" MaxLength="100"
                    FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"/>
                <Button Content="Save Owner Info" Click="SaveOwner_Click"
                    Background="#14FFFFFF" Foreground="#DDFFFFFF" BorderThickness="0"
                    FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans" FontSize="15"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Margin="0,4,0,0"/>

                <!-- ANIMATIONS -->
                <TextBlock Text="ANIMATIONS" FontSize="13" Foreground="#55FFFFFF"
                    FontFamily="/Assets/Fonts/MiSans-Demibold.ttf#MiSans" Margin="0,24,0,8"/>
                <Grid Background="#14FFFFFF">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Entry Animations" FontSize="15" Foreground="White"
                        FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"
                        VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <toolkit:ToggleSwitch x:Name="AnimToggle" Grid.Column="1"
                        Checked="AnimToggle_Changed" Unchecked="AnimToggle_Changed"/>
                </Grid>

                <!-- REMOVE.BG API KEY -->
                <TextBlock Text="REMOVE.BG API KEY" FontSize="13" Foreground="#55FFFFFF"
                    FontFamily="/Assets/Fonts/MiSans-Demibold.ttf#MiSans" Margin="0,24,0,8"/>
                <TextBox x:Name="ApiKeyBox" Background="#14FFFFFF" Foreground="White"
                    FontSize="14" FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"
                    LostFocus="ApiKey_LostFocus" InputScope="Url" BorderThickness="0"/>
                <TextBlock Text="Free: remove.bg/api • 50 lượt/tháng" FontSize="11"
                    Foreground="#44FFFFFF" HorizontalAlignment="Center" Margin="0,4,0,0"
                    FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"/>

                <!-- TOGETHER AI API TOKEN -->
                <TextBlock Text="TOGETHER AI API KEY" FontSize="13" Foreground="#55FFFFFF"
                    FontFamily="/Assets/Fonts/MiSans-Demibold.ttf#MiSans" Margin="0,24,0,8"/>
                <TextBox x:Name="TogetherApiKeyBox" Background="#14FFFFFF" Foreground="White"
                    FontSize="14" FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"
                    LostFocus="TogetherApiKey_LostFocus" InputScope="Default" BorderThickness="0"/>
                <TextBlock Text="Free: together.ai/settings/api-keys" FontSize="11"
                    Foreground="#44FFFFFF" HorizontalAlignment="Center" Margin="0,4,0,0"
                    FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"/>

                <!-- ABOUT -->
                <TextBlock Text=" " FontSize="13" Margin="0,16,0,0"/>
                <Button Content="ℹ About HyperOS" Click="About_Click"
                    Background="#14FFFFFF" Foreground="#DDFFFFFF" BorderThickness="0"
                    FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans" FontSize="15"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>

</phone:PhoneApplicationPage>
