<phone:PhoneApplicationPage
    x:Class="HyperOS.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:toolkit="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone.Controls.Toolkit"
    xmlns:controls="clr-namespace:HyperOS.Controls"
    SupportedOrientations="Portrait" Orientation="Portrait"
    shell:SystemTray.IsVisible="True"
    shell:SystemTray.BackgroundColor="#FF0D0D1A"
    shell:SystemTray.ForegroundColor="#AAFFFFFF"
    Loaded="SettingsPage_Loaded">

    <phone:PhoneApplicationPage.Resources>
        <!-- Modern card style -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#18FFFFFF"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <!-- Section title style -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="/Assets/Fonts/MiSans-Demibold.ttf#MiSans"/>
            <Setter Property="Foreground" Value="#FF6EC6FF"/>
            <Setter Property="Margin" Value="4,24,0,10"/>
        </Style>
        <!-- Setting title -->
        <Style x:Key="SettingTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontFamily" Value="/Assets/Fonts/MiSans-Regular.ttf#MiSans"/>
            <Setter Property="Foreground" Value="#F0FFFFFF"/>
        </Style>
        <!-- Setting subtitle -->
        <Style x:Key="SettingSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#77FFFFFF"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
        </Style>
        <!-- Divider -->
        <Style x:Key="Divider" TargetType="Rectangle">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Fill" Value="#0DFFFFFF"/>
            <Setter Property="Margin" Value="0,12,0,12"/>
        </Style>
        <!-- Action button -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="Foreground" Value="#DDFFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontFamily" Value="/Assets/Fonts/MiSans-Regular.ttf#MiSans"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
        <!-- Accent button (primary actions) -->
        <Style x:Key="AccentBtn" TargetType="Button">
            <Setter Property="Background" Value="#FF3A7BF2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontFamily" Value="/Assets/Fonts/MiSans-Regular.ttf#MiSans"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
    </phone:PhoneApplicationPage.Resources>

    <Grid>
        <!-- Background gradient -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FF0D0D1A" Offset="0"/>
                <GradientStop Color="#FF151528" Offset="0.5"/>
                <GradientStop Color="#FF0D0D1A" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ Header ═══ -->
        <Grid Grid.Row="0" Margin="22,16,22,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="HyperOS" FontSize="14" Foreground="#55FFFFFF"
                    FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"/>
                <TextBlock Text="Settings" FontSize="36" Foreground="White"
                    FontFamily="/Assets/Fonts/MiSans-Demibold.ttf#MiSans"
                    Margin="0,-4,0,0"/>
            </StackPanel>
            <!-- Gear icon area -->
            <Border Grid.Column="1" Width="40" Height="40" CornerRadius="20"
                Background="#18FFFFFF" VerticalAlignment="Bottom" Margin="0,0,0,4">
                <TextBlock Text="⚙" FontSize="20" Foreground="#88FFFFFF"
                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <!-- ═══ Content ═══ -->
        <ScrollViewer Grid.Row="1" Margin="20,0,20,0">
            <StackPanel>

                <!-- ─── LOCKSCREEN ─── -->
                <TextBlock Text="LOCKSCREEN" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <CheckBox x:Name="useIt" Content="Use as live lockscreen"
                            Foreground="White" FontSize="17"
                            FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"
                            Checked="useIt_Checked"
                            Unchecked="useIt_Unchecked"/>
                        <TextBlock x:Name="LockScreenStatus" Text=""
                            FontSize="12.5" Foreground="#55FFFFFF" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ─── SECURITY ─── -->
                <TextBlock Text="SECURITY" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <!-- PIN -->
                        <Grid Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="PIN Lock" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="4-digit PIN code" Style="{StaticResource SettingSub}"/>
                            </StackPanel>
                            <toolkit:ToggleSwitch x:Name="PasswordToggle" Grid.Column="1"
                                Checked="PasswordToggle_Checked"
                                Unchecked="PasswordToggle_Unchecked"/>
                        </Grid>

                        <StackPanel x:Name="PinSetupPanel" Visibility="Collapsed" Margin="0,8,0,0">
                            <TextBlock Text="Enter 4-digit PIN:" FontSize="13" Foreground="#77FFFFFF"/>
                            <PasswordBox x:Name="PinInput" MaxLength="4" FontSize="22"
                                Margin="0,4,0,0"/>
                            <Button Content="Set PIN" Click="SetPin_Click" Style="{StaticResource AccentBtn}"/>
                        </StackPanel>

                        <Rectangle Style="{StaticResource Divider}"/>

                        <!-- Pattern -->
                        <Grid Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Pattern Lock" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="Draw a pattern to unlock" Style="{StaticResource SettingSub}"/>
                            </StackPanel>
                            <toolkit:ToggleSwitch x:Name="PatternToggle" Grid.Column="1"
                                Checked="PatternToggle_Checked"
                                Unchecked="PatternToggle_Unchecked"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ─── CLOCK ─── -->
                <TextBlock Text="CLOCK" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <!-- Font -->
                        <TextBlock Text="Font" Style="{StaticResource SettingTitle}"/>
                        <TextBlock Text="Choose clock typeface" Style="{StaticResource SettingSub}" Margin="0,1,0,6"/>
                        <toolkit:ListPicker x:Name="ClockStylePicker"
                            SelectionChanged="ClockStylePicker_SelectionChanged">
                            <toolkit:ListPickerItem Content="MiSans Regular"/>
                            <toolkit:ListPickerItem Content="MiSans Bold"/>
                            <toolkit:ListPickerItem Content="Bebas Neue"/>
                            <toolkit:ListPickerItem Content="Segoe WP"/>
                            <toolkit:ListPickerItem Content="Segoe WP Black"/>
                        </toolkit:ListPicker>

                        <Rectangle Style="{StaticResource Divider}"/>

                        <!-- Size -->
                        <TextBlock Text="Size" Style="{StaticResource SettingTitle}"/>
                        <TextBlock Text="Adjust clock text size" Style="{StaticResource SettingSub}" Margin="0,1,0,6"/>
                        <toolkit:ListPicker x:Name="ClockSizePicker"
                            SelectionChanged="ClockSizePicker_SelectionChanged">
                            <toolkit:ListPickerItem Content="S (80)"/>
                            <toolkit:ListPickerItem Content="M (95)"/>
                            <toolkit:ListPickerItem Content="L (105)"/>
                            <toolkit:ListPickerItem Content="XL (120)"/>
                            <toolkit:ListPickerItem Content="XXL (140)"/>
                        </toolkit:ListPicker>
                    </StackPanel>
                </Border>

                <!-- Clock Position card -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Position" Style="{StaticResource SettingTitle}"/>
                        <TextBlock Text="Vertical placement" Style="{StaticResource SettingSub}" Margin="0,1,0,6"/>
                        <toolkit:ListPicker x:Name="ClockPositionPicker"
                            SelectionChanged="ClockPositionPicker_SelectionChanged">
                            <toolkit:ListPickerItem Content="Top"/>
                            <toolkit:ListPickerItem Content="Center"/>
                            <toolkit:ListPickerItem Content="Bottom"/>
                        </toolkit:ListPicker>

                        <Rectangle Style="{StaticResource Divider}"/>

                        <TextBlock Text="Alignment" Style="{StaticResource SettingTitle}"/>
                        <TextBlock Text="Horizontal placement" Style="{StaticResource SettingSub}" Margin="0,1,0,6"/>
                        <toolkit:ListPicker x:Name="ClockHAlignPicker"
                            SelectionChanged="ClockHAlignPicker_SelectionChanged">
                            <toolkit:ListPickerItem Content="Left"/>
                            <toolkit:ListPickerItem Content="Center"/>
                            <toolkit:ListPickerItem Content="Right"/>
                        </toolkit:ListPicker>
                    </StackPanel>
                </Border>

                <!-- Clock Color card -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Color" Style="{StaticResource SettingTitle}"/>
                        <TextBlock Text="Solid color" Style="{StaticResource SettingSub}" Margin="0,1,0,6"/>
                        <toolkit:ListPicker x:Name="ClockColorPicker"
                            SelectionChanged="ClockColorPicker_SelectionChanged">
                            <toolkit:ListPickerItem Content="White"/>
                            <toolkit:ListPickerItem Content="Gold"/>
                            <toolkit:ListPickerItem Content="Sky Blue"/>
                            <toolkit:ListPickerItem Content="Pink"/>
                            <toolkit:ListPickerItem Content="Red"/>
                        </toolkit:ListPicker>

                        <Rectangle Style="{StaticResource Divider}"/>

                        <TextBlock Text="Gradient" Style="{StaticResource SettingTitle}"/>
                        <TextBlock Text="Blend effect (overrides solid)" Style="{StaticResource SettingSub}" Margin="0,1,0,6"/>
                        <toolkit:ListPicker x:Name="ClockBlendPicker"
                            SelectionChanged="ClockBlendPicker_SelectionChanged">
                            <toolkit:ListPickerItem Content="None"/>
                            <toolkit:ListPickerItem Content="Sunset"/>
                            <toolkit:ListPickerItem Content="Ocean"/>
                            <toolkit:ListPickerItem Content="Aurora"/>
                            <toolkit:ListPickerItem Content="Neon"/>
                        </toolkit:ListPicker>
                    </StackPanel>
                </Border>

                <!-- ─── DISPLAY ─── -->
                <TextBlock Text="DISPLAY" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <!-- Animations -->
                        <Grid Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Animations" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="Entry effects on lock screen" Style="{StaticResource SettingSub}"/>
                            </StackPanel>
                            <toolkit:ToggleSwitch x:Name="AnimToggle" Grid.Column="1"
                                Checked="AnimToggle_Checked"
                                Unchecked="AnimToggle_Unchecked"/>
                        </Grid>

                        <Rectangle Style="{StaticResource Divider}"/>

                        <!-- Wallpaper -->
                        <TextBlock Text="Wallpaper" Style="{StaticResource SettingTitle}"/>
                        <TextBlock Text="Choose lock screen background" Style="{StaticResource SettingSub}"/>
                        <Button Content="Change Wallpaper" Click="ChangeWallpaper_Click"
                            Style="{StaticResource ActionBtn}"/>

                        <Rectangle Style="{StaticResource Divider}"/>

                        <!-- Owner Info -->
                        <TextBlock Text="Owner Info" Style="{StaticResource SettingTitle}"/>
                        <TextBlock Text="Text shown on lock screen" Style="{StaticResource SettingSub}" Margin="0,1,0,6"/>
                        <TextBox x:Name="OwnerInfoInput" MaxLength="100"
                            Background="#14FFFFFF" Foreground="White"
                            BorderThickness="0" FontSize="15"/>
                        <Button Content="Save" Click="SaveOwnerInfo_Click" Style="{StaticResource ActionBtn}"/>
                    </StackPanel>
                </Border>

                <!-- ─── WIDGETS ─── -->
                <TextBlock Text="WIDGETS" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <!-- Weather -->
                        <Grid Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Weather" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="Show temperature on lock screen" Style="{StaticResource SettingSub}"/>
                            </StackPanel>
                            <toolkit:ToggleSwitch x:Name="WeatherToggle" Grid.Column="1"
                                Checked="WeatherToggle_Checked"
                                Unchecked="WeatherToggle_Unchecked"/>
                        </Grid>

                        <Button Content="📍 Use GPS Location" Click="WeatherGPS_Click"
                            Style="{StaticResource ActionBtn}"/>

                        <TextBlock Text="Or enter city name" FontSize="12.5" Foreground="#55FFFFFF"
                            Margin="0,10,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="CityInput" Background="#14FFFFFF" Foreground="White"
                                BorderThickness="0" FontSize="15"/>
                            <Button Content="Search" Grid.Column="1" Click="WeatherCity_Click"
                                Style="{StaticResource ActionBtn}" Margin="4,6,0,0"
                                HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock x:Name="WeatherLocationInfo" Text="" FontSize="12"
                            Foreground="#44FFFFFF" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Countdown card -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <Grid Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Countdown" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="Count days to an event" Style="{StaticResource SettingSub}"/>
                            </StackPanel>
                            <toolkit:ToggleSwitch x:Name="CountdownToggle" Grid.Column="1"
                                Checked="CountdownToggle_Checked"
                                Unchecked="CountdownToggle_Unchecked"/>
                        </Grid>

                        <TextBlock Text="Event name" FontSize="12.5" Foreground="#55FFFFFF" Margin="0,6,0,4"/>
                        <TextBox x:Name="CountdownNameInput" Background="#14FFFFFF" Foreground="White"
                            BorderThickness="0" MaxLength="30" FontSize="15"/>
                        <TextBlock Text="Target date (yyyy-MM-dd)" FontSize="12.5" Foreground="#55FFFFFF"
                            Margin="0,8,0,4"/>
                        <TextBox x:Name="CountdownDateInput" Background="#14FFFFFF" Foreground="White"
                            BorderThickness="0" InputScope="Number" MaxLength="10" FontSize="15"/>
                        <Button Content="Save Countdown" Click="SaveCountdown_Click"
                            Style="{StaticResource AccentBtn}"/>
                    </StackPanel>
                </Border>

                <!-- ─── ADVANCED ─── -->
                <TextBlock Text="ADVANCED" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <!-- Depth Effect -->
                        <Grid Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Depth Effect" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="Clock behind subject (needs PNG)" Style="{StaticResource SettingSub}"/>
                            </StackPanel>
                            <toolkit:ToggleSwitch x:Name="DepthToggle" Grid.Column="1"
                                Checked="DepthToggle_Checked"
                                Unchecked="DepthToggle_Unchecked"/>
                        </Grid>
                        <Button Content="Choose Foreground PNG" Click="ChooseForeground_Click"
                            Style="{StaticResource ActionBtn}"/>
                    </StackPanel>
                </Border>

                <!-- ─── MY SETS ─── -->
                <TextBlock Text="MY SETS" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Save or load presets" FontSize="12.5" Foreground="#55FFFFFF"
                            Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="Set 1" Click="LoadSet1_Click"
                                Background="#14FFFFFF" Foreground="#DDFFFFFF" BorderThickness="0"
                                FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"
                                Margin="0,0,3,0"/>
                            <Button Content="Set 2" Click="LoadSet2_Click" Grid.Column="1"
                                Background="#14FFFFFF" Foreground="#DDFFFFFF" BorderThickness="0"
                                FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"
                                Margin="2,0,2,0"/>
                            <Button Content="Set 3" Click="LoadSet3_Click" Grid.Column="2"
                                Background="#14FFFFFF" Foreground="#DDFFFFFF" BorderThickness="0"
                                FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"
                                Margin="3,0,0,0"/>
                        </Grid>
                        <TextBlock Text="Tap to load · Hold to save" FontSize="11.5"
                            Foreground="#44FFFFFF" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ─── ABOUT ─── -->
                <Border Style="{StaticResource CardBorder}" Margin="0,8,0,32">
                    <Button Content="About HyperOS" Click="About_Click"
                        Background="Transparent" Foreground="#AAFFFFFF"
                        BorderThickness="0" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left" FontSize="17"
                        FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"/>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ============ PATTERN SETUP OVERLAY ============ -->
        <Grid x:Name="PatternSetupOverlay" Visibility="Collapsed">
            <Grid.Background>
                <SolidColorBrush Color="Black" Opacity="0.95"/>
            </Grid.Background>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Draw Your Pattern" FontSize="26"
                    Foreground="White"
                    FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"
                    HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="Connect at least 3 dots" FontSize="15"
                    Foreground="#AAFFFFFF"
                    FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"
                    HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <controls:PatternLockMetroControl x:Name="PatternSetupControl"
                    Width="320" Height="320"
                    IsRegisterationMode="True"
                    RegistrationSuccess="PatternSetupControl_RegistrationSuccess"/>

                <Button Content="Cancel" Tap="PatternSetupCancel_Tap"
                    Margin="0,24,0,0" Width="200"
                    Background="Transparent"
                    BorderBrush="#55FFFFFF" BorderThickness="1"
                    Foreground="White" FontSize="18"
                    FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"/>
            </StackPanel>
        </Grid>
    </Grid>

</phone:PhoneApplicationPage>
