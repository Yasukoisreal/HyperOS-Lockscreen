<phone:PhoneApplicationPage
    x:Class="HyperOS.Pages.LockScreen"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:toolkit="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone.Controls.Toolkit"
    SupportedOrientations="Portrait" Orientation="Portrait"
    shell:SystemTray.IsVisible="False"
    BackKeyPress="PhoneApplicationPage_BackKeyPress"
    Loaded="PhoneApplicationPage_Loaded">

    <phone:PhoneApplicationPage.Resources>
        <!-- Battery flash animation -->
        <Storyboard x:Name="FlashBattery" AutoReverse="True" RepeatBehavior="3x">
            <DoubleAnimation
                Storyboard.TargetProperty="(UIElement.Opacity)"
                Storyboard.TargetName="BatteryLowIcon"
                From="0" To="1" Duration="0:0:1">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Charging pulse animation -->
        <Storyboard x:Name="ChargingPulse" AutoReverse="True" RepeatBehavior="3x">
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetProperty="(UIElement.Opacity)"
                Storyboard.TargetName="ChargingIcon">
                <EasingDoubleKeyFrame KeyTime="0" Value="1"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1.5" Value="0.3">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <SineEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>


        <!-- Clock fade-in animation -->
        <Storyboard x:Key="TimeAnim">
            <!-- Hour: 0ms → 600ms -->
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetProperty="(UIElement.Opacity)"
                Storyboard.TargetName="HourPart">
                <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.600" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)"
                Storyboard.TargetName="HourPart">
                <EasingDoubleKeyFrame KeyTime="0" Value="30"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.600" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>

            <!-- Colon: 100ms → 700ms -->
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetProperty="(UIElement.Opacity)"
                Storyboard.TargetName="ColonPart">
                <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.100" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.700" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)"
                Storyboard.TargetName="ColonPart">
                <EasingDoubleKeyFrame KeyTime="0" Value="30"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.100" Value="30"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.700" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>

            <!-- Minute: 200ms → 800ms -->
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetProperty="(UIElement.Opacity)"
                Storyboard.TargetName="MinutePart">
                <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.200" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.800" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)"
                Storyboard.TargetName="MinutePart">
                <EasingDoubleKeyFrame KeyTime="0" Value="30"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.200" Value="30"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.800" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- Date & Widgets slide-in animation -->
        <Storyboard x:Key="DayAnim">
            <!-- DateInfoPanel -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="DateInfoPanel">
                <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.500" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)" Storyboard.TargetName="DateInfoPanel">
                <EasingDoubleKeyFrame KeyTime="0" Value="20"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.500" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            
            <!-- WeatherText -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="WeatherText">
                <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.500" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)" Storyboard.TargetName="WeatherText">
                <EasingDoubleKeyFrame KeyTime="0" Value="20"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.500" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>

            <!-- CountdownText -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="CountdownText">
                <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.500" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)" Storyboard.TargetName="CountdownText">
                <EasingDoubleKeyFrame KeyTime="0" Value="20"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.500" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>

            <!-- OwnerInfoText -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="OwnerInfoText">
                <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.500" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)" Storyboard.TargetName="OwnerInfoText">
                <EasingDoubleKeyFrame KeyTime="0" Value="20"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.500" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>

            <!-- MainSignatureText -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="MainSignatureText">
                <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.500" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)" Storyboard.TargetName="MainSignatureText">
                <EasingDoubleKeyFrame KeyTime="0" Value="20"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.500" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- DateAnim removed — duplicate of DayAnim -->

    </phone:PhoneApplicationPage.Resources>

    <Grid x:Name="LayoutRoot" Background="Black" Hold="LayoutRoot_Hold">

        <!-- ============ LOCK SCREEN PANEL ============ -->
        <Grid x:Name="LockScreenPanel" Background="Transparent"
              ManipulationStarted="LockScreenPanel_ManipulationStarted"
              ManipulationDelta="LockScreenPanel_ManipulationDelta"
              ManipulationCompleted="LockScreenPanel_ManipulationCompleted">
            <Grid.RenderTransform>
                <CompositeTransform/>
            </Grid.RenderTransform>

            <!-- Background Image — Full screen -->
            <Border x:Name="BackgroundImage" CacheMode="BitmapCache">
                <Border.Background>
                    <ImageBrush x:Name="BackgroundBrush" ImageSource="/Assets/BlurBackground.jpg" Stretch="UniformToFill"/>
                </Border.Background>
            </Border>


            <!-- ═══ BEHIND FOREGROUND LAYER — clock parts behind subject ═══ -->
            <Grid x:Name="BehindForegroundGrid" IsHitTestVisible="False" Visibility="Collapsed">
                <Grid.RenderTransform><CompositeTransform/></Grid.RenderTransform>
                <StackPanel x:Name="BehindClockPanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Margin="0,0,0,40">
                    <!-- Spacer matching DateInfoPanel: same font, size, margin, invisible -->
                    <StackPanel x:Name="BehindDateSpacer" Orientation="Horizontal"
                                HorizontalAlignment="Center" Margin="0,0,0,4">
                        <TextBlock Text="X" FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"
                            FontSize="20" Foreground="Transparent"/>
                    </StackPanel>
                    <!-- Behind clock parts -->
                    <StackPanel x:Name="BehindTimePanel" Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock x:Name="HourPartBehind" Text="20"
                            FontFamily="/Assets/Fonts/MiSans-Demibold.ttf#MiSans"
                            FontSize="105" Foreground="White">
                            <TextBlock.RenderTransform><CompositeTransform/></TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock x:Name="ColonPartBehind" Text=":"
                            FontFamily="/Assets/Fonts/MiSans-Demibold.ttf#MiSans"
                            FontSize="105" Foreground="White">
                            <TextBlock.RenderTransform><CompositeTransform/></TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock x:Name="MinutePartBehind" Text="05"
                            FontFamily="/Assets/Fonts/MiSans-Demibold.ttf#MiSans"
                            FontSize="105" Foreground="White">
                            <TextBlock.RenderTransform><CompositeTransform/></TextBlock.RenderTransform>
                        </TextBlock>
                    </StackPanel>
                    <Grid x:Name="RhombusGridBehind" Visibility="Collapsed" HorizontalAlignment="Center">
                        <Grid.RenderTransform><CompositeTransform/></Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock x:Name="RhombusH1Behind" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Text="1" FontFamily="/Assets/Fonts/MiSans-Demibold.ttf#MiSans" Foreground="White" FontSize="105"/>
                        <TextBlock x:Name="RhombusH2Behind" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Text="0" FontFamily="/Assets/Fonts/MiSans-Demibold.ttf#MiSans" Foreground="White" FontSize="105"/>
                        <TextBlock x:Name="RhombusM1Behind" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Text="5" FontFamily="/Assets/Fonts/MiSans-Demibold.ttf#MiSans" Foreground="White" FontSize="105"/>
                        <TextBlock x:Name="RhombusM2Behind" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Text="7" FontFamily="/Assets/Fonts/MiSans-Demibold.ttf#MiSans" Foreground="White" FontSize="105"/>
                        <Ellipse x:Name="RhombusDotBehind" Grid.Row="1" Grid.Column="1" Width="12" Height="12" Fill="#FFDC3232" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    
                    <!-- Stacked Grid Behind -->
                    <Grid x:Name="StackedGridBehind" Visibility="Collapsed" HorizontalAlignment="Left" Margin="12,0,0,0">
                        <Grid.RenderTransform><CompositeTransform/></Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="StackedCarrierBehind" Grid.Row="0" Text="Mi Mobile" FontSize="18" Foreground="#BBFFFFFF" FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"/>
                        <TextBlock x:Name="StackedTimeBehind" Grid.Row="1" Text="5:36" FontSize="100" Foreground="White" FontFamily="/Assets/Fonts/MiSans-Light.ttf#MiSans" Margin="-4,-12,0,-12"/>
                        <StackPanel x:Name="StackedDatePanelBehind" Grid.Row="2" Orientation="Horizontal">
                            <TextBlock x:Name="StackedDateBehind" Text="4/6" FontSize="44" Foreground="White" FontFamily="/Assets/Fonts/MiSans-Light.ttf#MiSans"/>
                            <TextBlock x:Name="StackedDayBehind" Text="THU" FontSize="18" Foreground="#99FFFFFF" FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans" VerticalAlignment="Top" Margin="8,8,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="StackedWeatherBehind" Grid.Row="3" Text="28° ☁" FontSize="44" Foreground="White" FontFamily="/Assets/Fonts/MiSans-Light.ttf#MiSans" Margin="0,-4,0,0"/>
                    </Grid>
                    
                    <Grid x:Name="UpwardGridBehind" Visibility="Collapsed" HorizontalAlignment="Center">
                        <Grid.RenderTransform><CompositeTransform/></Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="UpwardDateBehind" Grid.Row="0" Text="4/6" FontSize="44" Foreground="White" FontFamily="/Assets/Fonts/MiSans-Light.ttf#MiSans" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="UpwardTimeBehind" Grid.Row="1" Text="5:36" FontSize="100" Foreground="White" FontFamily="/Assets/Fonts/MiSans-Light.ttf#MiSans" HorizontalAlignment="Center" Margin="-4,-12,0,-12"/>
                        <TextBlock x:Name="UpwardDayBehind" Grid.Row="2" Text="THU" FontSize="24" Foreground="White" FontFamily="/Assets/Fonts/MiSans-Light.ttf#MiSans" HorizontalAlignment="Center"/>
                    </Grid>
                    <!-- Analog Clock Behind (Collapsed by default) -->
                    <Canvas x:Name="AnalogClockCanvasBehind" Width="200" Height="200"
                            HorizontalAlignment="Center" Visibility="Collapsed">
                        <Canvas.RenderTransform><CompositeTransform/></Canvas.RenderTransform>
                    </Canvas>
                </StackPanel>
            </Grid>

            <!-- ═══ SIGNATURE LAYER ═══ -->
            <TextBlock x:Name="MainSignatureText" Visibility="Collapsed"
                       HorizontalAlignment="Left" VerticalAlignment="Top">
                <TextBlock.RenderTransform><CompositeTransform/></TextBlock.RenderTransform>
            </TextBlock>

            <!-- ═══ DEPTH EFFECT — foreground overlay (subject PNG) ═══ -->
            <Border x:Name="ForegroundOverlay" CacheMode="BitmapCache" IsHitTestVisible="False" Visibility="Collapsed">
                <Border.Background>
                    <ImageBrush x:Name="ForegroundBrush" Stretch="UniformToFill"/>
                </Border.Background>
            </Border>


            <!-- ═══ FRONT LAYER — all widgets IN FRONT of foreground ═══ -->
            <Grid x:Name="OverlayInformationPanel">
                <Grid.RenderTransform><CompositeTransform/></Grid.RenderTransform>

                <!-- HyperOS Clock & Info -->
                <StackPanel x:Name="ClockPanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Margin="0,0,0,40">

                    <!-- Date & Day info line (centered above clock) -->
                    <StackPanel x:Name="DateInfoPanel" Orientation="Horizontal"
                                HorizontalAlignment="Center" Margin="0,0,0,4">
                        <StackPanel.RenderTransform><CompositeTransform/></StackPanel.RenderTransform>
                        <TextBlock x:Name="DayPanel" Text="Saturday"
                            FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"
                            FontSize="20" Foreground="#CCFFFFFF"/>
                        <TextBlock Text=" · " FontSize="20" Foreground="#88FFFFFF"
                            FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"/>
                        <TextBlock x:Name="DatePanel" Text="June 21"
                            FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"
                            FontSize="20" Foreground="#CCFFFFFF"/>
                    </StackPanel>

                    <!-- Large Time — split into Hour : Minute for depth control -->
                    <StackPanel x:Name="TimePanel" Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock x:Name="HourPart" Text="20"
                            FontFamily="/Assets/Fonts/MiSans-Demibold.ttf#MiSans"
                            FontSize="105" Foreground="White">
                            <TextBlock.RenderTransform><CompositeTransform/></TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock x:Name="ColonPart" Text=":"
                            FontFamily="/Assets/Fonts/MiSans-Demibold.ttf#MiSans"
                            FontSize="105" Foreground="White">
                            <TextBlock.RenderTransform><CompositeTransform/></TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock x:Name="MinutePart" Text="05"
                            FontFamily="/Assets/Fonts/MiSans-Demibold.ttf#MiSans"
                            FontSize="105" Foreground="White">
                            <TextBlock.RenderTransform><CompositeTransform/></TextBlock.RenderTransform>
                        </TextBlock>
                    </StackPanel>
                    <Grid x:Name="RhombusGrid" Visibility="Collapsed" HorizontalAlignment="Center">
                        <Grid.RenderTransform><CompositeTransform/></Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock x:Name="RhombusH1" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Text="1" FontFamily="/Assets/Fonts/MiSans-Demibold.ttf#MiSans" Foreground="White" FontSize="105"/>
                        <TextBlock x:Name="RhombusH2" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Text="0" FontFamily="/Assets/Fonts/MiSans-Demibold.ttf#MiSans" Foreground="White" FontSize="105"/>
                        <TextBlock x:Name="RhombusM1" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Text="5" FontFamily="/Assets/Fonts/MiSans-Demibold.ttf#MiSans" Foreground="White" FontSize="105"/>
                        <TextBlock x:Name="RhombusM2" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Text="7" FontFamily="/Assets/Fonts/MiSans-Demibold.ttf#MiSans" Foreground="White" FontSize="105"/>
                        <Ellipse x:Name="RhombusDot" Grid.Row="1" Grid.Column="1" Width="12" Height="12" Fill="#FFDC3232" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    
                    <!-- Stacked Grid Front -->
                    <Grid x:Name="StackedGrid" Visibility="Collapsed" HorizontalAlignment="Left" Margin="12,0,0,0">
                        <Grid.RenderTransform><CompositeTransform/></Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="StackedCarrier" Grid.Row="0" Text="Mi Mobile" FontSize="18" Foreground="#BBFFFFFF" FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"/>
                        <TextBlock x:Name="StackedTime" Grid.Row="1" Text="5:36" FontSize="100" Foreground="White" FontFamily="/Assets/Fonts/MiSans-Light.ttf#MiSans" Margin="-4,-12,0,-12"/>
                        <StackPanel x:Name="StackedDatePanel" Grid.Row="2" Orientation="Horizontal">
                            <TextBlock x:Name="StackedDate" Text="4/6" FontSize="44" Foreground="White" FontFamily="/Assets/Fonts/MiSans-Light.ttf#MiSans"/>
                            <TextBlock x:Name="StackedDay" Text="THU" FontSize="18" Foreground="#99FFFFFF" FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans" VerticalAlignment="Top" Margin="8,8,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="StackedWeather" Grid.Row="3" Text="28° ☁" FontSize="44" Foreground="White" FontFamily="/Assets/Fonts/MiSans-Light.ttf#MiSans" Margin="0,-4,0,0"/>
                    </Grid>
                    
                    <Grid x:Name="UpwardGrid" Visibility="Collapsed" HorizontalAlignment="Center">
                        <Grid.RenderTransform><CompositeTransform/></Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="UpwardDate" Grid.Row="0" Text="4/6" FontSize="44" Foreground="White" FontFamily="/Assets/Fonts/MiSans-Light.ttf#MiSans" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="UpwardTime" Grid.Row="1" Text="5:36" FontSize="100" Foreground="White" FontFamily="/Assets/Fonts/MiSans-Light.ttf#MiSans" HorizontalAlignment="Center" Margin="-4,-12,0,-12"/>
                        <TextBlock x:Name="UpwardDay" Grid.Row="2" Text="THU" FontSize="24" Foreground="White" FontFamily="/Assets/Fonts/MiSans-Light.ttf#MiSans" HorizontalAlignment="Center"/>
                    </Grid>
                    <!-- Analog Clock (Collapsed by default) -->
                    <Canvas x:Name="AnalogClockCanvas" Width="200" Height="200"
                            HorizontalAlignment="Center" Visibility="Collapsed">
                        <Canvas.RenderTransform><CompositeTransform/></Canvas.RenderTransform>
                    </Canvas>
                </StackPanel>

                <!-- Weather widget (independent position) -->
                <TextBlock x:Name="WeatherText" Text=""
                    FontSize="18" Foreground="#BBFFFFFF"
                    FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Visibility="Collapsed">
                    <TextBlock.RenderTransform><CompositeTransform/></TextBlock.RenderTransform>
                </TextBlock>

                <!-- Countdown widget (independent position) -->
                <TextBlock x:Name="CountdownText" Text=""
                    FontSize="16" Foreground="#99FFFFFF"
                    FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Visibility="Collapsed">
                    <TextBlock.RenderTransform><CompositeTransform/></TextBlock.RenderTransform>
                </TextBlock>

                <!-- Owner info text (independent position) -->
                <TextBlock x:Name="OwnerInfoText" Text=""
                    FontSize="16" Foreground="#88FFFFFF"
                    FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    TextWrapping="Wrap" MaxWidth="350"
                    Visibility="Collapsed">
                    <TextBlock.RenderTransform><CompositeTransform/></TextBlock.RenderTransform>
                </TextBlock>

                <!-- Battery & Charging info — top right -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,5,12,0">
                    <!-- Charging icon -->
                    <TextBlock x:Name="ChargingIcon" Text="⚡" FontSize="16" Foreground="#AAFFCC00"
                        VerticalAlignment="Center" Margin="0,0,2,0" Visibility="Collapsed"/>
                    <Image x:Name="BatteryLowIcon"
                        Source="/Assets/Battery/appbar.battery.1.png"
                        Width="24" Height="24"
                        VerticalAlignment="Center"
                        Opacity="0" Visibility="Collapsed" Margin="0,0,4,0"/>
                    <TextBlock x:Name="BatteryText" Text=""
                        FontSize="14" Foreground="#AAFFFFFF"
                        FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"
                        VerticalAlignment="Center" Visibility="Collapsed"/>
                </StackPanel>




                <!-- Quick shortcuts — bottom corners (HyperOS style) -->
                <!-- Flashlight (left) -->
                <Border x:Name="FlashlightButton" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                        Margin="24,0,0,24" Width="44" Height="44"
                        CornerRadius="22" Background="#22FFFFFF"
                        Tap="FlashlightShortcut_Tap">
                    <Canvas Width="16" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Rectangle x:Name="FlashlightHead" Canvas.Left="2" Canvas.Top="0" Width="12" Height="7"
                                   RadiusX="2" RadiusY="2"
                                   Stroke="White" StrokeThickness="1.3" Fill="Transparent"/>
                        <Rectangle x:Name="FlashlightBody" Canvas.Left="4" Canvas.Top="7" Width="8" Height="10"
                                   RadiusX="1" RadiusY="1"
                                   Stroke="White" StrokeThickness="1.3" Fill="Transparent"/>
                        <Ellipse x:Name="FlashlightBeam" Canvas.Left="6.5" Canvas.Top="10" Width="3" Height="3"
                                 Fill="White"/>
                    </Canvas>
                </Border>
                <!-- Camera (right) -->
                <Border VerticalAlignment="Bottom" HorizontalAlignment="Right"
                        Margin="0,0,24,24" Width="44" Height="44"
                        CornerRadius="22" Background="#22FFFFFF"
                        Tap="CameraShortcut_Tap">
                    <Canvas Width="22" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Rectangle Canvas.Left="1" Canvas.Top="4" Width="20" Height="13"
                                   RadiusX="2" RadiusY="2"
                                   Stroke="White" StrokeThickness="1.2" Fill="Transparent"/>
                        <Ellipse Canvas.Left="7" Canvas.Top="6" Width="8" Height="8"
                                 Stroke="White" StrokeThickness="1.2" Fill="Transparent"/>
                        <Path Data="M7,4 L9,1 L13,1 L15,4"
                              Stroke="White" StrokeThickness="1.2" Fill="Transparent"/>
                    </Canvas>
                </Border>
            </Grid>
        </Grid>

        <!-- ============ MY SETS OVERLAY ============ -->
        <Grid x:Name="MySetsOverlay" Visibility="Collapsed" Background="#EE111111">
            <!-- Header -->
            <Grid VerticalAlignment="Top" Margin="16,28,16,0" Canvas.ZIndex="10">
                <TextBlock Text="My Sets"
                    FontFamily="/Assets/Fonts/MiSans-Demibold.ttf#MiSans"
                    FontSize="20" Foreground="#AAFFFFFF"
                    HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <Border Tap="MySets_Close_Tap" HorizontalAlignment="Right"
                    Width="40" Height="40" Background="Transparent">
                    <TextBlock Text="✕" FontSize="18" Foreground="#77FFFFFF"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- Title -->
            <StackPanel VerticalAlignment="Top" Margin="24,60,24,0" Canvas.ZIndex="10">
                <TextBlock x:Name="MySetsCategory" Text="CLASSIC"
                    FontFamily="/Assets/Fonts/MiSans-Demibold.ttf#MiSans"
                    FontSize="12" Foreground="#AAFFFFFF" HorizontalAlignment="Center"
                    Margin="0,0,0,2"/>
                <TextBlock x:Name="MySetsTitle" Text="Classic"
                    FontFamily="/Assets/Fonts/MiSans-Demibold.ttf#MiSans"
                    FontSize="32" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock x:Name="MySetsSubtitle" Text=""
                    FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"
                    FontSize="13" Foreground="#77FFFFFF" HorizontalAlignment="Center"
                    Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Carousel Canvas -->
            <Canvas x:Name="MySetsCarousel"
                    Margin="0,150,0,100"
                    Background="Transparent"
                    ManipulationDelta="MySets_ManipulationDelta"
                    ManipulationCompleted="MySets_ManipulationCompleted"/>

            <!-- Bottom -->
            <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,20" HorizontalAlignment="Center">
                <Border Tap="MySets_Apply_Tap"
                    Background="#55FFFFFF" CornerRadius="22" Padding="36,10"
                    Margin="0,0,0,14">
                    <TextBlock Text="Apply"
                        FontFamily="/Assets/Fonts/MiSans-Demibold.ttf#MiSans"
                        FontSize="15" Foreground="White" HorizontalAlignment="Center"/>
                </Border>
                <StackPanel x:Name="MySetsDotsPanel" Orientation="Horizontal" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>

</phone:PhoneApplicationPage>
