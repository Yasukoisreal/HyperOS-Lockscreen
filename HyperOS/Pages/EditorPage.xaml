<phone:PhoneApplicationPage
    x:Class="HyperOS.Pages.EditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:toolkit="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone.Controls.Toolkit"
    SupportedOrientations="Portrait" Orientation="Portrait"
    shell:SystemTray.IsVisible="False"
    Loaded="EditorPage_Loaded">

    <phone:PhoneApplicationPage.Resources>
        <!-- Tab pill style (inactive) -->
        <Style x:Key="TabPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="#22FFFFFF"/>
        </Style>
        <Style x:Key="TabText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#AAFFFFFF"/>
            <Setter Property="FontFamily" Value="/Assets/Fonts/MiSans-Regular.ttf#MiSans"/>
        </Style>
        <Style x:Key="PropLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#55FFFFFF"/>
            <Setter Property="FontFamily" Value="/Assets/Fonts/MiSans-Regular.ttf#MiSans"/>
            <Setter Property="Margin" Value="0,10,0,6"/>
        </Style>
        <Style x:Key="PropOptionPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Background" Value="#18FFFFFF"/>
        </Style>
        <Style x:Key="PropOptionText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
            <Setter Property="FontFamily" Value="/Assets/Fonts/MiSans-Regular.ttf#MiSans"/>
        </Style>
        <Style x:Key="EditorActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="Foreground" Value="#DDFFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="/Assets/Fonts/MiSans-Regular.ttf#MiSans"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </phone:PhoneApplicationPage.Resources>

    <Grid Background="#FF080810">

        <!-- ═══════════════════════════════════════════════════ -->
        <!--          FULL-SCREEN LIVE PREVIEW                  -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Grid x:Name="PreviewArea" Background="Black">

            <!-- Background image -->
            <Border Tap="Background_Tap">
                <Border.Background>
                    <ImageBrush x:Name="PreviewBgBrush" Stretch="UniformToFill"/>
                </Border.Background>
            </Border>

            <!-- Bottom gradient for readability -->
            <Rectangle VerticalAlignment="Bottom" Height="420" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0"/>
                        <GradientStop Color="#99000000" Offset="0.5"/>
                        <GradientStop Color="#CC000000" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- ═══ DRAGGABLE ELEMENTS ═══ -->

            <!-- Clock + Date group -->
            <Border x:Name="ClockHandle" Tag="Clock"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    BorderThickness="1.5" BorderBrush="Transparent"
                    Padding="4" Background="Transparent"
                    ManipulationDelta="Element_ManipulationDelta"
                    ManipulationCompleted="Element_ManipulationCompleted"
                    Tap="Element_Tap">
                <Border.RenderTransform><CompositeTransform/></Border.RenderTransform>
                <StackPanel>
                    <StackPanel x:Name="PDatePanel" Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock x:Name="PDay" Text="Monday"
                            FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"
                            FontSize="20" Foreground="#CCFFFFFF"/>
                        <TextBlock Text=" · " FontSize="20" Foreground="#88FFFFFF"
                            FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"/>
                        <TextBlock x:Name="PDate" Text="June 22"
                            FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"
                            FontSize="20" Foreground="#CCFFFFFF"/>
                    </StackPanel>
                    <StackPanel x:Name="PTimePanel" Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock x:Name="PHour" Text="21"
                            FontFamily="/Assets/Fonts/MiSans-Demibold.ttf#MiSans"
                            FontSize="105" Foreground="White"/>
                        <TextBlock x:Name="PColon" Text=":"
                            FontFamily="/Assets/Fonts/MiSans-Demibold.ttf#MiSans"
                            FontSize="105" Foreground="White"/>
                        <TextBlock x:Name="PMinute" Text="30"
                            FontFamily="/Assets/Fonts/MiSans-Demibold.ttf#MiSans"
                            FontSize="105" Foreground="White"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Weather -->
            <Border x:Name="WeatherHandle" Tag="Weather"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    BorderThickness="1.5" BorderBrush="Transparent"
                    Padding="4" Background="Transparent"
                    ManipulationDelta="Element_ManipulationDelta"
                    ManipulationCompleted="Element_ManipulationCompleted"
                    Tap="Element_Tap">
                <Border.RenderTransform><CompositeTransform/></Border.RenderTransform>
                <TextBlock x:Name="PWeather" Text="☀ 28°C"
                    FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"
                    FontSize="18" Foreground="#BBFFFFFF"/>
            </Border>

            <!-- Countdown -->
            <Border x:Name="CountdownHandle" Tag="Countdown"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    BorderThickness="1.5" BorderBrush="Transparent"
                    Padding="4" Background="Transparent"
                    ManipulationDelta="Element_ManipulationDelta"
                    ManipulationCompleted="Element_ManipulationCompleted"
                    Tap="Element_Tap">
                <Border.RenderTransform><CompositeTransform/></Border.RenderTransform>
                <TextBlock x:Name="PCountdown" Text="⏱ 30 days"
                    FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"
                    FontSize="16" Foreground="#99FFFFFF"/>
            </Border>

            <!-- Foreground overlay (depth effect preview) -->
            <Border x:Name="PreviewFg" IsHitTestVisible="False" Visibility="Collapsed">
                <Border.Background>
                    <ImageBrush x:Name="PreviewFgBrush" Stretch="UniformToFill"/>
                </Border.Background>
            </Border>

            <!-- Battery indicator (non-draggable, top-right) -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,5,12,0" IsHitTestVisible="False">
                <TextBlock x:Name="PBattery" Text="🔋 85%"
                    FontSize="14" Foreground="#AAFFFFFF"
                    FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"/>
            </StackPanel>

            <!-- Bottom shortcuts preview (non-interactive) -->
            <Border VerticalAlignment="Bottom" HorizontalAlignment="Left"
                    Margin="24,0,0,24" Width="44" Height="44"
                    CornerRadius="22" Background="#22FFFFFF" IsHitTestVisible="False">
                <Canvas Width="16" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Rectangle Canvas.Left="2" Canvas.Top="0" Width="12" Height="7"
                               RadiusX="2" RadiusY="2"
                               Stroke="White" StrokeThickness="1.3" Fill="Transparent"/>
                    <Rectangle Canvas.Left="4" Canvas.Top="7" Width="8" Height="10"
                               RadiusX="1" RadiusY="1"
                               Stroke="White" StrokeThickness="1.3" Fill="Transparent"/>
                    <Ellipse Canvas.Left="6.5" Canvas.Top="10" Width="3" Height="3" Fill="White"/>
                </Canvas>
            </Border>
            <Border VerticalAlignment="Bottom" HorizontalAlignment="Right"
                    Margin="0,0,24,24" Width="44" Height="44"
                    CornerRadius="22" Background="#22FFFFFF" IsHitTestVisible="False">
                <Canvas Width="22" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Rectangle Canvas.Left="1" Canvas.Top="4" Width="20" Height="13"
                               RadiusX="2" RadiusY="2"
                               Stroke="White" StrokeThickness="1.2" Fill="Transparent"/>
                    <Ellipse Canvas.Left="7" Canvas.Top="6" Width="8" Height="8"
                             Stroke="White" StrokeThickness="1.2" Fill="Transparent"/>
                    <Path Data="M7,4 L9,1 L13,1 L15,4"
                          Stroke="White" StrokeThickness="1.2" Fill="Transparent"/>
                </Canvas>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════ -->
        <!--              HEADER OVERLAY (top)                  -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Grid VerticalAlignment="Top" Height="56" IsHitTestVisible="True">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#DD080810" Offset="0"/>
                    <GradientStop Color="#00080810" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                <Border Tap="Back_Tap" Width="44" Height="44" Background="Transparent">
                    <TextBlock Text="◀" FontSize="18" Foreground="White"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Editor" FontSize="22" Foreground="White"
                    FontFamily="/Assets/Fonts/MiSans-Demibold.ttf#MiSans"
                    VerticalAlignment="Center" Margin="4,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,8,0">
                <Border Tap="SaveAndBack_Tap" CornerRadius="14" Padding="12,6"
                        Background="#FF3A7BF2"
                        ToolTipService.ToolTip="Save">
                    <TextBlock Text="Save" FontSize="14" Foreground="White"
                        FontFamily="/Assets/Fonts/MiSans-Demibold.ttf#MiSans"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ═══════════════════════════════════════════════════ -->
        <!--       BOTTOM CONTROLS (tab bar + properties)       -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Grid VerticalAlignment="Bottom">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ─── TAB BAR ─── -->
            <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled" Height="44"
                          Margin="0,0,0,0">
                <StackPanel Orientation="Horizontal" Margin="12,4,12,4">
                    <Border x:Name="TabClock" Style="{StaticResource TabPill}"
                            Tap="Tab_Tap" Tag="Clock">
                        <TextBlock x:Name="TabClockText" Text="🕐 Clock" Style="{StaticResource TabText}"/>
                    </Border>
                    <Border x:Name="TabWeather" Style="{StaticResource TabPill}"
                            Tap="Tab_Tap" Tag="Weather">
                        <TextBlock x:Name="TabWeatherText" Text="🌤 Weather" Style="{StaticResource TabText}"/>
                    </Border>
                    <Border x:Name="TabCountdown" Style="{StaticResource TabPill}"
                            Tap="Tab_Tap" Tag="Countdown">
                        <TextBlock x:Name="TabCountdownText" Text="⏱ Countdown" Style="{StaticResource TabText}"/>
                    </Border>
                    <Border x:Name="TabDisplay" Style="{StaticResource TabPill}"
                            Tap="Tab_Tap" Tag="Display">
                        <TextBlock x:Name="TabDisplayText" Text="🖼 Display" Style="{StaticResource TabText}"/>
                    </Border>
                    <Border x:Name="TabMore" Style="{StaticResource TabPill}"
                            Tap="Tab_Tap" Tag="More">
                        <TextBlock x:Name="TabMoreText" Text="⚙ More" Style="{StaticResource TabText}"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ─── PROPERTY PANEL ─── -->
            <Border Grid.Row="1" x:Name="PropPanel"
                    CornerRadius="16,16,0,0" MaxHeight="260">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#F5101020" Offset="0"/>
                        <GradientStop Color="#F5080814" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <ScrollViewer Margin="0,6,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,0,16,16">

                        <!-- ══ CLOCK PROPERTIES ══ -->
                        <StackPanel x:Name="ClockProps" Visibility="Visible">
                            <!-- Font -->
                            <TextBlock Text="FONT" Style="{StaticResource PropLabel}"/>
                            <StackPanel Orientation="Horizontal">
                                <Border Tap="FontPrev_Tap" Style="{StaticResource PropOptionPill}">
                                    <TextBlock Text="◀" Style="{StaticResource PropOptionText}"/>
                                </Border>
                                <Border Background="#22FFFFFF" CornerRadius="10" Padding="16,6" Margin="0,0,5,0">
                                    <TextBlock x:Name="FontLabel" Text="MiSans Bold"
                                        FontSize="13" Foreground="White"
                                        FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"/>
                                </Border>
                                <Border Tap="FontNext_Tap" Style="{StaticResource PropOptionPill}">
                                    <TextBlock Text="▶" Style="{StaticResource PropOptionText}"/>
                                </Border>
                            </StackPanel>

                            <!-- Size -->
                            <TextBlock Text="SIZE" Style="{StaticResource PropLabel}"/>
                            <StackPanel x:Name="SizePanel" Orientation="Horizontal">
                                <Border x:Name="SizeS" Tap="Size_Tap" Tag="0" Style="{StaticResource PropOptionPill}">
                                    <TextBlock Text="S" Style="{StaticResource PropOptionText}"/>
                                </Border>
                                <Border x:Name="SizeM" Tap="Size_Tap" Tag="1" Style="{StaticResource PropOptionPill}">
                                    <TextBlock Text="M" Style="{StaticResource PropOptionText}"/>
                                </Border>
                                <Border x:Name="SizeL" Tap="Size_Tap" Tag="2" Style="{StaticResource PropOptionPill}">
                                    <TextBlock Text="L" Style="{StaticResource PropOptionText}"/>
                                </Border>
                                <Border x:Name="SizeXL" Tap="Size_Tap" Tag="3" Style="{StaticResource PropOptionPill}">
                                    <TextBlock Text="XL" Style="{StaticResource PropOptionText}"/>
                                </Border>
                                <Border x:Name="SizeXXL" Tap="Size_Tap" Tag="4" Style="{StaticResource PropOptionPill}">
                                    <TextBlock Text="XXL" Style="{StaticResource PropOptionText}"/>
                                </Border>
                            </StackPanel>

                            <!-- Color -->
                            <TextBlock Text="COLOR" Style="{StaticResource PropLabel}"/>
                            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="ColorW" Width="32" Height="32" Fill="White"
                                         Stroke="Transparent" StrokeThickness="2"
                                         Tap="Color_Tap" Tag="0" Margin="0,0,8,0"/>
                                <Ellipse x:Name="ColorG" Width="32" Height="32" Fill="#FFD700"
                                         Stroke="Transparent" StrokeThickness="2"
                                         Tap="Color_Tap" Tag="1" Margin="0,0,8,0"/>
                                <Ellipse x:Name="ColorB" Width="32" Height="32" Fill="#87CEEB"
                                         Stroke="Transparent" StrokeThickness="2"
                                         Tap="Color_Tap" Tag="2" Margin="0,0,8,0"/>
                                <Ellipse x:Name="ColorP" Width="32" Height="32" Fill="#FFB6C1"
                                         Stroke="Transparent" StrokeThickness="2"
                                         Tap="Color_Tap" Tag="3" Margin="0,0,8,0"/>
                                <Ellipse x:Name="ColorR" Width="32" Height="32" Fill="#FF4444"
                                         Stroke="Transparent" StrokeThickness="2"
                                         Tap="Color_Tap" Tag="4" Margin="0,0,8,0"/>
                                <Ellipse x:Name="ColorMint" Width="32" Height="32" Fill="#5BFFB0"
                                         Stroke="Transparent" StrokeThickness="2"
                                         Tap="Color_Tap" Tag="5" Margin="0,0,8,0"/>
                                <Ellipse x:Name="ColorLav" Width="32" Height="32" Fill="#C4A7FF"
                                         Stroke="Transparent" StrokeThickness="2"
                                         Tap="Color_Tap" Tag="6" Margin="0,0,8,0"/>
                                <Ellipse x:Name="ColorOr" Width="32" Height="32" Fill="#FF8C42"
                                         Stroke="Transparent" StrokeThickness="2"
                                         Tap="Color_Tap" Tag="7" Margin="0,0,8,0"/>
                                <Ellipse x:Name="ColorCy" Width="32" Height="32" Fill="#00E5FF"
                                         Stroke="Transparent" StrokeThickness="2"
                                         Tap="Color_Tap" Tag="8" Margin="0,0,8,0"/>
                                <Ellipse x:Name="ColorSi" Width="32" Height="32" Fill="#A0A0B0"
                                         Stroke="Transparent" StrokeThickness="2"
                                         Tap="Color_Tap" Tag="9" Margin="0,0,0,0"/>
                            </StackPanel>
                            </ScrollViewer>

                            <!-- Gradient -->
                            <TextBlock Text="GRADIENT" Style="{StaticResource PropLabel}"/>
                            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="BlendPanel" Orientation="Horizontal">
                                <Border x:Name="BlendNone" Tap="Blend_Tap" Tag="0" Style="{StaticResource PropOptionPill}">
                                    <TextBlock Text="None" Style="{StaticResource PropOptionText}"/>
                                </Border>
                                <Border x:Name="BlendSunset" Tap="Blend_Tap" Tag="1" Style="{StaticResource PropOptionPill}">
                                    <TextBlock Text="Sunset" Style="{StaticResource PropOptionText}"/>
                                </Border>
                                <Border x:Name="BlendOcean" Tap="Blend_Tap" Tag="2" Style="{StaticResource PropOptionPill}">
                                    <TextBlock Text="Ocean" Style="{StaticResource PropOptionText}"/>
                                </Border>
                                <Border x:Name="BlendAurora" Tap="Blend_Tap" Tag="3" Style="{StaticResource PropOptionPill}">
                                    <TextBlock Text="Aurora" Style="{StaticResource PropOptionText}"/>
                                </Border>
                                <Border x:Name="BlendNeon" Tap="Blend_Tap" Tag="4" Style="{StaticResource PropOptionPill}">
                                    <TextBlock Text="Neon" Style="{StaticResource PropOptionText}"/>
                                </Border>
                                <Border x:Name="BlendRose" Tap="Blend_Tap" Tag="5" Style="{StaticResource PropOptionPill}">
                                    <TextBlock Text="Rose" Style="{StaticResource PropOptionText}"/>
                                </Border>
                                <Border x:Name="BlendFire" Tap="Blend_Tap" Tag="6" Style="{StaticResource PropOptionPill}">
                                    <TextBlock Text="Fire" Style="{StaticResource PropOptionText}"/>
                                </Border>
                                <Border x:Name="BlendIce" Tap="Blend_Tap" Tag="7" Style="{StaticResource PropOptionPill}">
                                    <TextBlock Text="Ice" Style="{StaticResource PropOptionText}"/>
                                </Border>
                                <Border x:Name="BlendLime" Tap="Blend_Tap" Tag="8" Style="{StaticResource PropOptionPill}">
                                    <TextBlock Text="Lime" Style="{StaticResource PropOptionText}"/>
                                </Border>
                                <Border x:Name="BlendTwilight" Tap="Blend_Tap" Tag="9" Style="{StaticResource PropOptionPill}">
                                    <TextBlock Text="Twilight" Style="{StaticResource PropOptionText}"/>
                                </Border>
                            </StackPanel>
                            </ScrollViewer>

                            <!-- Date Align -->
                            <TextBlock Text="DATE ALIGN" Style="{StaticResource PropLabel}"/>
                            <StackPanel x:Name="DateAlignPanel" Orientation="Horizontal">
                                <Border x:Name="AlignLeft" Tap="DateAlign_Tap" Tag="0" Style="{StaticResource PropOptionPill}">
                                    <TextBlock Text="Left" Style="{StaticResource PropOptionText}"/>
                                </Border>
                                <Border x:Name="AlignCenter" Tap="DateAlign_Tap" Tag="1" Style="{StaticResource PropOptionPill}">
                                    <TextBlock Text="Center" Style="{StaticResource PropOptionText}"/>
                                </Border>
                                <Border x:Name="AlignRight" Tap="DateAlign_Tap" Tag="2" Style="{StaticResource PropOptionPill}">
                                    <TextBlock Text="Right" Style="{StaticResource PropOptionText}"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- ══ WEATHER PROPERTIES ══ -->
                        <StackPanel x:Name="WeatherProps" Visibility="Collapsed">
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Show Weather" FontSize="16" Foreground="White"
                                    FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"
                                    VerticalAlignment="Center"/>
                                <toolkit:ToggleSwitch x:Name="EdWeatherToggle" Grid.Column="1"
                                    Checked="EdWeatherToggle_Changed" Unchecked="EdWeatherToggle_Changed"/>
                            </Grid>
                            <Button Content="📍 Set Location..." Click="EdWeatherLocation_Click"
                                Style="{StaticResource EditorActionBtn}"/>
                        </StackPanel>

                        <!-- ══ COUNTDOWN PROPERTIES ══ -->
                        <StackPanel x:Name="CountdownProps" Visibility="Collapsed">
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Show Countdown" FontSize="16" Foreground="White"
                                    FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"
                                    VerticalAlignment="Center"/>
                                <toolkit:ToggleSwitch x:Name="EdCountdownToggle" Grid.Column="1"
                                    Checked="EdCountdownToggle_Changed" Unchecked="EdCountdownToggle_Changed"/>
                            </Grid>
                            <TextBlock Text="Event name" Style="{StaticResource PropLabel}"/>
                            <TextBox x:Name="EdCountdownName" Background="#14FFFFFF" Foreground="White"
                                BorderThickness="0" FontSize="14" MaxLength="30"/>
                            <TextBlock Text="Target date (yyyy-MM-dd)" Style="{StaticResource PropLabel}"/>
                            <TextBox x:Name="EdCountdownDate" Background="#14FFFFFF" Foreground="White"
                                BorderThickness="0" InputScope="Number" MaxLength="10" FontSize="14"/>
                            <Button Content="Save Countdown" Click="EdSaveCountdown_Click"
                                Style="{StaticResource EditorActionBtn}"/>
                        </StackPanel>

                        <!-- ══ DISPLAY PROPERTIES ══ -->
                        <StackPanel x:Name="DisplayProps" Visibility="Collapsed">
                            <Button Content="🖼 Change Wallpaper" Click="EdWallpaper_Click"
                                Style="{StaticResource EditorActionBtn}" Margin="0,8,0,0"/>

                            <TextBlock Text="DEPTH EFFECT" Style="{StaticResource PropLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Depth Effect" FontSize="15" Foreground="White"
                                    FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"
                                    VerticalAlignment="Center"/>
                                <toolkit:ToggleSwitch x:Name="EdDepthToggle" Grid.Column="1"
                                    Checked="EdDepthToggle_Changed" Unchecked="EdDepthToggle_Changed"/>
                            </Grid>
                            <Button x:Name="EdForegroundBtn" Content="📁 Choose Foreground PNG"
                                Click="EdForeground_Click" Style="{StaticResource EditorActionBtn}"/>
                            <Button x:Name="EdAutoExtractBtn" Content="✨ Auto Extract Foreground"
                                Click="EdAutoExtract_Click" Style="{StaticResource EditorActionBtn}" Margin="0,4,0,0"/>
                            <TextBlock x:Name="ExtractStatus" Text="" FontSize="12"
                                Foreground="#88FFFFFF" HorizontalAlignment="Center" Margin="0,4,0,0"
                                FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"/>

                            <StackPanel x:Name="EdDepthLayers" Visibility="Collapsed">
                                <TextBlock Text="DEPTH LAYERS  (ON = Behind)" Style="{StaticResource PropLabel}"/>
                                <Grid><Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                    <TextBlock Text="Hour" FontSize="14" Foreground="#CCC" VerticalAlignment="Center"
                                        FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"/>
                                    <toolkit:ToggleSwitch x:Name="EdDepthHour" Grid.Column="1"
                                        Checked="EdDepthLayer_Changed" Unchecked="EdDepthLayer_Changed"/>
                                </Grid>
                                <Grid><Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                    <TextBlock Text="Colon" FontSize="14" Foreground="#CCC" VerticalAlignment="Center"
                                        FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"/>
                                    <toolkit:ToggleSwitch x:Name="EdDepthColon" Grid.Column="1"
                                        Checked="EdDepthLayer_Changed" Unchecked="EdDepthLayer_Changed"/>
                                </Grid>
                                <Grid><Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                    <TextBlock Text="Minute" FontSize="14" Foreground="#CCC" VerticalAlignment="Center"
                                        FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"/>
                                    <toolkit:ToggleSwitch x:Name="EdDepthMinute" Grid.Column="1"
                                        Checked="EdDepthLayer_Changed" Unchecked="EdDepthLayer_Changed"/>
                                </Grid>
                            </StackPanel>

                            <TextBlock Text="ANIMATIONS" Style="{StaticResource PropLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Entry Animations" FontSize="15" Foreground="White"
                                    FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"
                                    VerticalAlignment="Center"/>
                                <toolkit:ToggleSwitch x:Name="EdAnimToggle" Grid.Column="1"
                                    Checked="EdAnimToggle_Changed" Unchecked="EdAnimToggle_Changed"/>
                            </Grid>

                            <TextBlock Text="OWNER INFO" Style="{StaticResource PropLabel}"/>
                            <TextBox x:Name="EdOwnerInfo" Background="#14FFFFFF" Foreground="White"
                                BorderThickness="0" FontSize="14" MaxLength="100"/>
                            <Button Content="Save Owner Info" Click="EdSaveOwner_Click"
                                Style="{StaticResource EditorActionBtn}"/>
                        </StackPanel>

                        <!-- ══ MORE (Security, Sets, About) ══ -->
                        <StackPanel x:Name="MoreProps" Visibility="Collapsed">
                            <Button Content="🔐 Security Settings" Click="EdSecurity_Click"
                                Style="{StaticResource EditorActionBtn}" Margin="0,8,0,0"/>

                            <TextBlock Text=" " Style="{StaticResource PropLabel}"/>
                            <Button Content="ℹ About HyperOS" Click="EdAbout_Click"
                                Style="{StaticResource EditorActionBtn}"/>

                            <TextBlock Text="LOCK SCREEN" Style="{StaticResource PropLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Use as live lockscreen" FontSize="15" Foreground="White"
                                    FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"
                                    VerticalAlignment="Center"/>
                                <toolkit:ToggleSwitch x:Name="EdLockToggle" Grid.Column="1"
                                    Checked="EdLockToggle_Changed" Unchecked="EdLockToggle_Changed"/>
                            </Grid>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ═══ ALIGNMENT GUIDES ═══ -->
        <Rectangle x:Name="GuideV" IsHitTestVisible="False" Width="1"
                   Fill="#66FF4081" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                   Visibility="Collapsed"/>
        <Rectangle x:Name="GuideH" IsHitTestVisible="False" Height="1"
                   Fill="#66FF4081" HorizontalAlignment="Stretch" VerticalAlignment="Top"
                   Visibility="Collapsed"/>

        <!-- ═══ UNSAVED CHANGES DIALOG ═══ -->
        <Grid x:Name="UnsavedDialog" Visibility="Collapsed">
            <!-- Dim background -->
            <Rectangle Fill="#99000000"/>
            <!-- Dialog card -->
            <Border Background="#FF1E1E2E" CornerRadius="16" 
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Width="400" Padding="24,20,24,16">
                <StackPanel>
                    <TextBlock Text="Chưa lưu" FontSize="22" FontWeight="Bold" 
                               Foreground="White" Margin="0,0,0,8"
                               FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"/>
                    <TextBlock Text="Bạn có thay đổi chưa lưu. Bạn muốn làm gì?"
                               FontSize="15" Foreground="#BBFFFFFF" TextWrapping="Wrap"
                               Margin="0,0,0,20"
                               FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Save -->
                        <Border Grid.Column="0" Background="#3A7BF2" CornerRadius="8"
                                Tap="UnsavedDialog_Save" Margin="0,0,4,0" Padding="0,12">
                            <TextBlock Text="Save" HorizontalAlignment="Center"
                                       FontSize="15" Foreground="White" FontWeight="Bold"
                                       FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"/>
                        </Border>
                        <!-- Don't Save -->
                        <Border Grid.Column="1" Background="#33FFFFFF" CornerRadius="8"
                                Tap="UnsavedDialog_DontSave" Margin="2,0,2,0" Padding="0,12">
                            <TextBlock Text="Don't Save" HorizontalAlignment="Center"
                                       FontSize="14" Foreground="#DDFFFFFF"
                                       FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"/>
                        </Border>
                        <!-- Cancel -->
                        <Border Grid.Column="2" Background="#33FFFFFF" CornerRadius="8"
                                Tap="UnsavedDialog_Cancel" Margin="4,0,0,0" Padding="0,12">
                            <TextBlock Text="Cancel" HorizontalAlignment="Center"
                                       FontSize="15" Foreground="#DDFFFFFF"
                                       FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"/>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>

</phone:PhoneApplicationPage>
