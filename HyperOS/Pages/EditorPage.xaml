<phone:PhoneApplicationPage
    x:Class="HyperOS.Pages.EditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:toolkit="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone.Controls.Toolkit"
    SupportedOrientations="Portrait" Orientation="Portrait"
    shell:SystemTray.IsVisible="False"
    Loaded="EditorPage_Loaded">

    <phone:PhoneApplicationPage.Resources>
        <!-- Tab pill style (inactive) -->
        <Style x:Key="TabPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="#22FFFFFF"/>
        </Style>
        <Style x:Key="TabText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#AAFFFFFF"/>
            <Setter Property="FontFamily" Value="/Assets/Fonts/MiSans-Regular.ttf#MiSans"/>
        </Style>
        <Style x:Key="PropLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#55FFFFFF"/>
            <Setter Property="FontFamily" Value="/Assets/Fonts/MiSans-Regular.ttf#MiSans"/>
            <Setter Property="Margin" Value="0,10,0,6"/>
        </Style>
        <Style x:Key="PropOptionPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Background" Value="#18FFFFFF"/>
        </Style>
        <Style x:Key="PropOptionText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
            <Setter Property="FontFamily" Value="/Assets/Fonts/MiSans-Regular.ttf#MiSans"/>
        </Style>
        <Style x:Key="EditorActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="Foreground" Value="#DDFFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="/Assets/Fonts/MiSans-Regular.ttf#MiSans"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </phone:PhoneApplicationPage.Resources>

    <Grid Background="#FF080810">

        <!-- ═══════════════════════════════════════════════════ -->
        <!--          FULL-SCREEN LIVE PREVIEW                  -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Grid x:Name="PreviewArea" Background="Black">

            <!-- Background image -->
            <!-- Background image -->
            <Border x:Name="PreviewBgBorder" Tap="Background_Tap" DoubleTap="PreviewArea_DoubleTap">
                <Border.Background>
                    <ImageBrush x:Name="PreviewBgBrush" Stretch="UniformToFill"/>
                </Border.Background>
            </Border>

            <!-- Bottom gradient for readability -->
            <Rectangle VerticalAlignment="Bottom" Height="420" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0"/>
                        <GradientStop Color="#99000000" Offset="0.5"/>
                        <GradientStop Color="#CC000000" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- ═══ DRAGGABLE ELEMENTS ═══ -->

            <!-- Clock + Date group -->
            <Border x:Name="ClockHandle" Tag="Clock"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    BorderThickness="1.5" BorderBrush="Transparent"
                    Padding="4" Background="Transparent"
                    ManipulationDelta="Element_ManipulationDelta"
                    ManipulationCompleted="Element_ManipulationCompleted"
                    Tap="Element_Tap">
                <Border.RenderTransform><CompositeTransform/></Border.RenderTransform>
                <StackPanel>
                    <StackPanel x:Name="PDatePanel" Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock x:Name="PDay" Text="Monday"
                            FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"
                            FontSize="20" Foreground="#CCFFFFFF"/>
                        <TextBlock Text=" · " FontSize="20" Foreground="#88FFFFFF"
                            FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"/>
                        <TextBlock x:Name="PDate" Text="June 22"
                            FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"
                            FontSize="20" Foreground="#CCFFFFFF"/>
                    </StackPanel>
                    <StackPanel x:Name="PTimePanel" Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock x:Name="PHour" Text="21"
                            FontFamily="/Assets/Fonts/MiSans-Demibold.ttf#MiSans"
                            FontSize="105" Foreground="White"/>
                        <TextBlock x:Name="PColon" Text=":"
                            FontFamily="/Assets/Fonts/MiSans-Demibold.ttf#MiSans"
                            FontSize="105" Foreground="White"/>
                        <TextBlock x:Name="PMinute" Text="30"
                            FontFamily="/Assets/Fonts/MiSans-Demibold.ttf#MiSans"
                            FontSize="105" Foreground="White"/>
                    </StackPanel>
                    <Grid x:Name="PRhombusGrid" Visibility="Collapsed" HorizontalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock x:Name="PRhombusH1" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Text="1" FontFamily="/Assets/Fonts/MiSans-Demibold.ttf#MiSans" Foreground="White" FontSize="105"/>
                        <TextBlock x:Name="PRhombusH2" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Text="0" FontFamily="/Assets/Fonts/MiSans-Demibold.ttf#MiSans" Foreground="White" FontSize="105"/>
                        <TextBlock x:Name="PRhombusM1" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Text="5" FontFamily="/Assets/Fonts/MiSans-Demibold.ttf#MiSans" Foreground="White" FontSize="105"/>
                        <TextBlock x:Name="PRhombusM2" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Text="7" FontFamily="/Assets/Fonts/MiSans-Demibold.ttf#MiSans" Foreground="White" FontSize="105"/>
                        <Ellipse x:Name="PRhombusCenterDot" Grid.Row="1" Grid.Column="1" Width="12" Height="12" Fill="#FFDC3232" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <!-- Analog Clock Preview (Collapsed by default) -->
                    <Canvas x:Name="PAnalogClock" Width="200" Height="200"
                            HorizontalAlignment="Center" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- Weather -->
            <Border x:Name="WeatherHandle" Tag="Weather"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    BorderThickness="1.5" BorderBrush="Transparent"
                    Padding="4" Background="Transparent"
                    ManipulationDelta="Element_ManipulationDelta"
                    ManipulationCompleted="Element_ManipulationCompleted"
                    Tap="Element_Tap">
                <Border.RenderTransform><CompositeTransform/></Border.RenderTransform>
                <TextBlock x:Name="PWeather" Text="☀ 28°C"
                    FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"
                    FontSize="18" Foreground="#BBFFFFFF"/>
            </Border>

            <!-- Countdown -->
            <Border x:Name="CountdownHandle" Tag="Countdown"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    BorderThickness="1.5" BorderBrush="Transparent"
                    Padding="4" Background="Transparent"
                    ManipulationDelta="Element_ManipulationDelta"
                    ManipulationCompleted="Element_ManipulationCompleted"
                    Tap="Element_Tap">
                <Border.RenderTransform><CompositeTransform/></Border.RenderTransform>
                <TextBlock x:Name="PCountdown" Text="⏱ 30 days"
                    FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"
                    FontSize="16" Foreground="#99FFFFFF"/>
            </Border>

            <!-- Signature (Magazine Style) -->
            <Border x:Name="SignatureHandle" Tag="Signature"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    BorderThickness="1.5" BorderBrush="Transparent"
                    Padding="4" Background="Transparent" Visibility="Collapsed"
                    ManipulationDelta="Element_ManipulationDelta"
                    ManipulationCompleted="Element_ManipulationCompleted"
                    Tap="Element_Tap">
                <Border.RenderTransform><CompositeTransform/></Border.RenderTransform>
                <TextBlock x:Name="PSignature" Text="LIFE"
                    FontFamily="/Assets/Fonts/PlayfairDisplay-Regular.ttf#Playfair Display"
                    FontSize="48" Foreground="White" CharacterSpacing="500" />
            </Border>

            <!-- Depth subject overlay -->
            <Border x:Name="PreviewFg" IsHitTestVisible="False" Visibility="Collapsed">
                <Border.Background>
                    <ImageBrush x:Name="PreviewFgBrush" Stretch="UniformToFill"/>
                </Border.Background>
            </Border>

            <!-- Depth front layer: clock parts that appear IN FRONT of foreground -->
            <Canvas x:Name="DepthFrontCanvas" IsHitTestVisible="False">
                <StackPanel x:Name="FrontDate" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock x:Name="FrontDay"
                        FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"
                        FontSize="20" Foreground="#CCFFFFFF"/>
                    <TextBlock Text=" · " FontSize="20" Foreground="#88FFFFFF"
                        FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"/>
                    <TextBlock x:Name="FrontDateText"
                        FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"
                        FontSize="20" Foreground="#CCFFFFFF"/>
                </StackPanel>
                <TextBlock x:Name="FrontHour" Visibility="Collapsed"
                    FontFamily="/Assets/Fonts/MiSans-Demibold.ttf#MiSans"
                    FontSize="105" Foreground="White"/>
                <TextBlock x:Name="FrontColon" Visibility="Collapsed"
                    FontFamily="/Assets/Fonts/MiSans-Demibold.ttf#MiSans"
                    FontSize="105" Foreground="White"/>
                <TextBlock x:Name="FrontMinute" Visibility="Collapsed"
                    FontFamily="/Assets/Fonts/MiSans-Demibold.ttf#MiSans"
                    FontSize="105" Foreground="White"/>
                <TextBlock x:Name="FrontRhombusH1" Visibility="Collapsed"
                    FontFamily="/Assets/Fonts/MiSans-Demibold.ttf#MiSans"
                    FontSize="105" Foreground="White"/>
                <TextBlock x:Name="FrontRhombusH2" Visibility="Collapsed"
                    FontFamily="/Assets/Fonts/MiSans-Demibold.ttf#MiSans"
                    FontSize="105" Foreground="White"/>
                <TextBlock x:Name="FrontRhombusM1" Visibility="Collapsed"
                    FontFamily="/Assets/Fonts/MiSans-Demibold.ttf#MiSans"
                    FontSize="105" Foreground="White"/>
                <TextBlock x:Name="FrontRhombusM2" Visibility="Collapsed"
                    FontFamily="/Assets/Fonts/MiSans-Demibold.ttf#MiSans"
                    FontSize="105" Foreground="White"/>
                <Ellipse x:Name="FrontRhombusDot" Visibility="Collapsed"
                    Width="12" Height="12" Fill="#FFDC3232"/>
            </Canvas>

            <!-- Battery indicator (non-draggable, top-right) -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,5,12,0" IsHitTestVisible="False">
                <TextBlock x:Name="PBattery" Text="🔋 85%"
                    FontSize="14" Foreground="#AAFFFFFF"
                    FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"/>
            </StackPanel>

            <!-- Bottom shortcuts preview (non-interactive) -->
            <Border VerticalAlignment="Bottom" HorizontalAlignment="Left"
                    Margin="24,0,0,24" Width="44" Height="44"
                    CornerRadius="22" Background="#22FFFFFF" IsHitTestVisible="False">
                <Canvas Width="16" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Rectangle Canvas.Left="2" Canvas.Top="0" Width="12" Height="7"
                               RadiusX="2" RadiusY="2"
                               Stroke="White" StrokeThickness="1.3" Fill="Transparent"/>
                    <Rectangle Canvas.Left="4" Canvas.Top="7" Width="8" Height="10"
                               RadiusX="1" RadiusY="1"
                               Stroke="White" StrokeThickness="1.3" Fill="Transparent"/>
                    <Ellipse Canvas.Left="6.5" Canvas.Top="10" Width="3" Height="3" Fill="White"/>
                </Canvas>
            </Border>
            <Border VerticalAlignment="Bottom" HorizontalAlignment="Right"
                    Margin="0,0,24,24" Width="44" Height="44"
                    CornerRadius="22" Background="#22FFFFFF" IsHitTestVisible="False">
                <Canvas Width="22" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Rectangle Canvas.Left="1" Canvas.Top="4" Width="20" Height="13"
                               RadiusX="2" RadiusY="2"
                               Stroke="White" StrokeThickness="1.2" Fill="Transparent"/>
                    <Ellipse Canvas.Left="7" Canvas.Top="6" Width="8" Height="8"
                             Stroke="White" StrokeThickness="1.2" Fill="Transparent"/>
                    <Path Data="M7,4 L9,1 L13,1 L15,4"
                          Stroke="White" StrokeThickness="1.2" Fill="Transparent"/>
                </Canvas>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════ -->
        <!--              HEADER OVERLAY (top)                  -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Grid x:Name="HeaderBar" VerticalAlignment="Top" Height="56" IsHitTestVisible="True">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#DD080810" Offset="0"/>
                    <GradientStop Color="#00080810" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                <Border Tap="Back_Tap" Width="44" Height="44" Background="Transparent">
                    <TextBlock Text="◀" FontSize="18" Foreground="White"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Editor" FontSize="22" Foreground="White"
                    FontFamily="/Assets/Fonts/MiSans-Demibold.ttf#MiSans"
                    VerticalAlignment="Center" Margin="4,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,8,0">
                <Border Tap="SaveAndBack_Tap" CornerRadius="14" Padding="12,6"
                        Background="#FF3A7BF2"
                        ToolTipService.ToolTip="Save">
                    <TextBlock Text="Save" FontSize="14" Foreground="White"
                        FontFamily="/Assets/Fonts/MiSans-Demibold.ttf#MiSans"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ═══════════════════════════════════════════════════ -->
        <!--       FLOATING POPUP MENU CONTAINER                -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Border x:Name="PropPanel" VerticalAlignment="Bottom" Margin="16,0,16,84"
                CornerRadius="16" Background="#DD1A1A2E" Visibility="Collapsed"
                BorderThickness="1" BorderBrush="#33FFFFFF" MaxHeight="320">
            <ScrollViewer Margin="0,12,0,12" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,0,16,0">

                        <!-- ══ CLOCK PROPERTIES ══ -->
                        <StackPanel x:Name="ClockProps" Visibility="Visible">
                            <!-- Layout -->
                            <TextBlock Text="LAYOUT" Style="{StaticResource PropLabel}"/>
                            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="LayoutPanel" Orientation="Horizontal">
                                <Border x:Name="LayoutHoriz" Tap="Layout_Tap" Tag="0" Style="{StaticResource PropOptionPill}">
                                    <TextBlock Text="Horizontal" Style="{StaticResource PropOptionText}"/>
                                </Border>
                                <Border x:Name="LayoutVert" Tap="Layout_Tap" Tag="1" Style="{StaticResource PropOptionPill}">
                                    <TextBlock Text="Vertical" Style="{StaticResource PropOptionText}"/>
                                </Border>
                                <Border x:Name="LayoutAnalog1" Tap="Layout_Tap" Tag="2" Style="{StaticResource PropOptionPill}">
                                    <TextBlock Text="Minimal" Style="{StaticResource PropOptionText}"/>
                                </Border>
                                <Border x:Name="LayoutAnalog2" Tap="Layout_Tap" Tag="3" Style="{StaticResource PropOptionPill}">
                                    <TextBlock Text="Classic" Style="{StaticResource PropOptionText}"/>
                                </Border>
                                <Border x:Name="LayoutAnalog3" Tap="Layout_Tap" Tag="4" Style="{StaticResource PropOptionPill}">
                                    <TextBlock Text="Swiss" Style="{StaticResource PropOptionText}"/>
                                </Border>
                                <Border x:Name="LayoutRhombus" Tap="Layout_Tap" Tag="5" Style="{StaticResource PropOptionPill}">
                                    <TextBlock Text="Rhombus" Style="{StaticResource PropOptionText}"/>
                                </Border>
                                <Border x:Name="LayoutGiant" Tap="Layout_Tap" Tag="6" Style="{StaticResource PropOptionPill}">
                                    <TextBlock Text="Giant" Style="{StaticResource PropOptionText}"/>
                                </Border>
                            </StackPanel>
                            </ScrollViewer>

                            <!-- Font (hidden for analog) -->
                            <StackPanel x:Name="FontSection">
                            <TextBlock Text="FONT" Style="{StaticResource PropLabel}"/>
                            <StackPanel Orientation="Horizontal">
                                <Border Tap="FontPrev_Tap" Style="{StaticResource PropOptionPill}">
                                    <TextBlock Text="◀" Style="{StaticResource PropOptionText}"/>
                                </Border>
                                <Border Background="#22FFFFFF" CornerRadius="10" Padding="16,6" Margin="0,0,5,0">
                                    <TextBlock x:Name="FontLabel" Text="MiSans Bold"
                                        FontSize="13" Foreground="White"
                                        FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"/>
                                </Border>
                                <Border Tap="FontNext_Tap" Style="{StaticResource PropOptionPill}">
                                    <TextBlock Text="▶" Style="{StaticResource PropOptionText}"/>
                                </Border>
                            </StackPanel>
                            </StackPanel>

                            <!-- Size -->
                            <TextBlock Text="SIZE" Style="{StaticResource PropLabel}"/>
                            <StackPanel x:Name="SizePanel" Orientation="Horizontal">
                                <Border x:Name="SizeS" Tap="Size_Tap" Tag="0" Style="{StaticResource PropOptionPill}">
                                    <TextBlock Text="S" Style="{StaticResource PropOptionText}"/>
                                </Border>
                                <Border x:Name="SizeM" Tap="Size_Tap" Tag="1" Style="{StaticResource PropOptionPill}">
                                    <TextBlock Text="M" Style="{StaticResource PropOptionText}"/>
                                </Border>
                                <Border x:Name="SizeL" Tap="Size_Tap" Tag="2" Style="{StaticResource PropOptionPill}">
                                    <TextBlock Text="L" Style="{StaticResource PropOptionText}"/>
                                </Border>
                                <Border x:Name="SizeXL" Tap="Size_Tap" Tag="3" Style="{StaticResource PropOptionPill}">
                                    <TextBlock Text="XL" Style="{StaticResource PropOptionText}"/>
                                </Border>
                                <Border x:Name="SizeXXL" Tap="Size_Tap" Tag="4" Style="{StaticResource PropOptionPill}">
                                    <TextBlock Text="XXL" Style="{StaticResource PropOptionText}"/>
                                </Border>
                            </StackPanel>

                            <!-- Date Align (manual) -->
                            <TextBlock Text="DATE ALIGN" Style="{StaticResource PropLabel}"/>
                            <StackPanel x:Name="DateAlignPanel" Orientation="Horizontal" Visibility="Visible">
                                <Border x:Name="AlignLeft" Tap="DateAlign_Tap" Tag="0" Style="{StaticResource PropOptionPill}">
                                    <TextBlock Text="Left" Style="{StaticResource PropOptionText}"/>
                                </Border>
                                <Border x:Name="AlignCenter" Tap="DateAlign_Tap" Tag="1" Style="{StaticResource PropOptionPill}">
                                    <TextBlock Text="Center" Style="{StaticResource PropOptionText}"/>
                                </Border>
                                <Border x:Name="AlignRight" Tap="DateAlign_Tap" Tag="2" Style="{StaticResource PropOptionPill}">
                                    <TextBlock Text="Right" Style="{StaticResource PropOptionText}"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- ══ WIDGETS PROPERTIES (Toggles) ══ -->
                        <StackPanel x:Name="WidgetsProps" Visibility="Collapsed">
                            <TextBlock Text="ADD WIDGETS" Style="{StaticResource PropLabel}"/>
                            
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Show Weather" FontSize="16" Foreground="White"
                                    FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"
                                    VerticalAlignment="Center"/>
                                <toolkit:ToggleSwitch x:Name="EdWeatherToggle" Grid.Column="1"
                                    Checked="EdWeatherToggle_Changed" Unchecked="EdWeatherToggle_Changed"/>
                            </Grid>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Show Countdown" FontSize="16" Foreground="White"
                                    FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"
                                    VerticalAlignment="Center"/>
                                <toolkit:ToggleSwitch x:Name="EdCountdownToggle" Grid.Column="1"
                                    Checked="EdCountdownToggle_Changed" Unchecked="EdCountdownToggle_Changed"/>
                            </Grid>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Show Signature" FontSize="16" Foreground="White"
                                    FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"
                                    VerticalAlignment="Center"/>
                                <toolkit:ToggleSwitch x:Name="EdSignatureToggle" Grid.Column="1"
                                    Checked="EdSignatureToggle_Changed" Unchecked="EdSignatureToggle_Changed"/>
                            </Grid>
                            <TextBlock Text="Tap on the element in the preview to edit its settings." FontSize="13" Foreground="#88FFFFFF"
                                FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans" TextWrapping="Wrap" Margin="0,12,0,0"/>
                        </StackPanel>

                        <!-- ══ WEATHER PROPERTIES ══ -->
                        <StackPanel x:Name="WeatherProps" Visibility="Collapsed">

                            <TextBlock Text="LOCATION" Style="{StaticResource PropLabel}"/>
                            <TextBox x:Name="EdWeatherCity" Background="#14FFFFFF" Foreground="White"
                                BorderThickness="0" FontSize="14"
                                FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"
                                InputScope="Maps"/>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Content="📍 Save" Click="EdWeatherLocation_Click"
                                    Style="{StaticResource EditorActionBtn}"/>
                                <Button Content="📡 GPS" Click="EdWeatherGps_Click" Grid.Column="2"
                                    Style="{StaticResource EditorActionBtn}"/>
                            </Grid>
                            <TextBlock x:Name="WeatherStatus" Text="" FontSize="12"
                                Foreground="#88FFFFFF" HorizontalAlignment="Center" Margin="0,4,0,0"
                                FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"/>
                        </StackPanel>

                        <!-- ══ COUNTDOWN PROPERTIES ══ -->
                        <StackPanel x:Name="CountdownProps" Visibility="Collapsed">

                            <TextBlock Text="Event name" Style="{StaticResource PropLabel}"/>
                            <TextBox x:Name="EdCountdownName" Background="#14FFFFFF" Foreground="White"
                                BorderThickness="0" FontSize="14" MaxLength="30"/>
                            <TextBlock Text="Target date (yyyy-MM-dd)" Style="{StaticResource PropLabel}"/>
                            <TextBox x:Name="EdCountdownDate" Background="#14FFFFFF" Foreground="White"
                                BorderThickness="0" InputScope="Number" MaxLength="10" FontSize="14"/>
                            <Button Content="Save Countdown" Click="EdSaveCountdown_Click"
                                Style="{StaticResource EditorActionBtn}"/>
                        </StackPanel>

                        <!-- ══ SIGNATURE PROPERTIES ══ -->
                        <StackPanel x:Name="SignatureProps" Visibility="Collapsed">


                            <TextBlock Text="LAYOUT" Style="{StaticResource PropLabel}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border x:Name="SigLayoutHoriz" Tap="SigLayout_Tap" Tag="0" Style="{StaticResource PropOptionPill}">
                                    <TextBlock Text="Horizontal" Style="{StaticResource PropOptionText}"/>
                                </Border>
                                <Border x:Name="SigLayoutVert" Tap="SigLayout_Tap" Tag="1" Style="{StaticResource PropOptionPill}">
                                    <TextBlock Text="Vertical" Style="{StaticResource PropOptionText}"/>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="SIGNATURE TEXT" Style="{StaticResource PropLabel}"/>
                            <TextBox x:Name="EdSignatureText" Background="#14FFFFFF" Foreground="White"
                                BorderThickness="0" FontSize="14" MaxLength="20"
                                FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"/>
                            
                            <TextBlock Text="FONT" Style="{StaticResource PropLabel}"/>
                            <StackPanel Orientation="Horizontal">
                                <Border Tap="SigFontPrev_Tap" Style="{StaticResource PropOptionPill}">
                                    <TextBlock Text="◀" Style="{StaticResource PropOptionText}"/>
                                </Border>
                                <Border Background="#22FFFFFF" CornerRadius="10" Padding="16,6" Margin="0,0,5,0">
                                    <TextBlock x:Name="SigFontLabel" Text="Playfair Display"
                                        FontSize="13" Foreground="White"
                                        FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"/>
                                </Border>
                                <Border Tap="SigFontNext_Tap" Style="{StaticResource PropOptionPill}">
                                    <TextBlock Text="▶" Style="{StaticResource PropOptionText}"/>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="LETTER SPACING" Style="{StaticResource PropLabel}"/>
                            <Slider x:Name="EdSigSpacing" Minimum="0" Maximum="2000" SmallChange="50" LargeChange="200"
                                    Value="500" ValueChanged="EdSigSpacing_ValueChanged"/>

                            <TextBlock Text="ALIGNMENT" Style="{StaticResource PropLabel}"/>
                            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="SigAlignTL" Tap="SigAlign_Tap" Tag="0" Style="{StaticResource PropOptionPill}">
                                        <TextBlock Text="Top-L" Style="{StaticResource PropOptionText}"/>
                                    </Border>
                                    <Border x:Name="SigAlignTC" Tap="SigAlign_Tap" Tag="1" Style="{StaticResource PropOptionPill}">
                                        <TextBlock Text="Top-C" Style="{StaticResource PropOptionText}"/>
                                    </Border>
                                    <Border x:Name="SigAlignTR" Tap="SigAlign_Tap" Tag="2" Style="{StaticResource PropOptionPill}">
                                        <TextBlock Text="Top-R" Style="{StaticResource PropOptionText}"/>
                                    </Border>
                                    <Border x:Name="SigAlignBL" Tap="SigAlign_Tap" Tag="3" Style="{StaticResource PropOptionPill}">
                                        <TextBlock Text="Bot-L" Style="{StaticResource PropOptionText}"/>
                                    </Border>
                                    <Border x:Name="SigAlignBC" Tap="SigAlign_Tap" Tag="4" Style="{StaticResource PropOptionPill}">
                                        <TextBlock Text="Bot-C" Style="{StaticResource PropOptionText}"/>
                                    </Border>
                                    <Border x:Name="SigAlignBR" Tap="SigAlign_Tap" Tag="5" Style="{StaticResource PropOptionPill}">
                                        <TextBlock Text="Bot-R" Style="{StaticResource PropOptionText}"/>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                            
                            <Button Content="Save Signature" Click="EdSaveSignature_Click"
                                Style="{StaticResource EditorActionBtn}" Margin="0,8,0,0"/>
                        </StackPanel>

                        <!-- ══ FILTER PROPERTIES ══ -->
                        <StackPanel x:Name="FilterProps" Visibility="Collapsed">
                            <TextBlock Text="FILTERS" Style="{StaticResource PropLabel}"/>
                            <toolkit:ToggleSwitch x:Name="MatteToggle" Header="Matte Effect (Blur)" Foreground="White"
                                                  Checked="MatteToggle_Checked" Unchecked="MatteToggle_Unchecked"/>
                            <toolkit:ToggleSwitch x:Name="RibbedToggle" Header="Ribbed Effect" Foreground="White"
                                                  Checked="RibbedToggle_Checked" Unchecked="RibbedToggle_Unchecked"/>
                            
                            <TextBlock x:Name="FilterProcessingText" Text="Processing filter..." Visibility="Collapsed"
                                       Foreground="#FFDC3232" FontSize="14" Margin="12,0,0,10"
                                       FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"/>
                        </StackPanel>

                        <!-- ══ DEPTH PROPERTIES ══ -->
                        <StackPanel x:Name="DepthProps" Visibility="Collapsed">
                            <TextBlock Text="DEPTH EFFECT" Style="{StaticResource PropLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Depth Effect" FontSize="15" Foreground="White"
                                    FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"
                                    VerticalAlignment="Center"/>
                                <toolkit:ToggleSwitch x:Name="EdDepthToggle" Grid.Column="1"
                                    Checked="EdDepthToggle_Changed" Unchecked="EdDepthToggle_Changed"/>
                            </Grid>
                            <Button x:Name="EdForegroundBtn" Content="📁 Choose Foreground PNG"
                                Click="EdForeground_Click" Style="{StaticResource EditorActionBtn}"/>
                            <Button x:Name="EdAutoExtractBtn" Content="✨ Auto Extract Foreground"
                                Click="EdAutoExtract_Click" Style="{StaticResource EditorActionBtn}" Margin="0,4,0,0"/>
                            <TextBlock x:Name="ExtractStatus" Text="" FontSize="12"
                                Foreground="#88FFFFFF" HorizontalAlignment="Center" Margin="0,4,0,0"
                                FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"/>

                            <StackPanel x:Name="EdDepthLayers" Visibility="Collapsed">
                                <TextBlock Text="DEPTH LAYERS  (ON = Behind)" Style="{StaticResource PropLabel}"/>
                                <!-- Analog: single clock toggle -->
                                <Grid x:Name="DepthRowClock" Visibility="Collapsed"><Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                    <TextBlock Text="Clock" FontSize="14" Foreground="#CCC" VerticalAlignment="Center"
                                        FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"/>
                                    <toolkit:ToggleSwitch x:Name="EdDepthClock" Grid.Column="1"
                                        Checked="EdDepthLayer_Changed" Unchecked="EdDepthLayer_Changed"/>
                                </Grid>
                                <!-- Digital: Hour -->
                                <Grid x:Name="DepthRowHour"><Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                    <TextBlock Text="Hour" FontSize="14" Foreground="#CCC" VerticalAlignment="Center"
                                        FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"/>
                                    <toolkit:ToggleSwitch x:Name="EdDepthHour" Grid.Column="1"
                                        Checked="EdDepthLayer_Changed" Unchecked="EdDepthLayer_Changed"/>
                                </Grid>
                                <!-- Digital: Colon (hidden for vertical/analog) -->
                                <Grid x:Name="DepthRowColon"><Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                    <TextBlock Text="Colon" FontSize="14" Foreground="#CCC" VerticalAlignment="Center"
                                        FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"/>
                                    <toolkit:ToggleSwitch x:Name="EdDepthColon" Grid.Column="1"
                                        Checked="EdDepthLayer_Changed" Unchecked="EdDepthLayer_Changed"/>
                                </Grid>
                                <!-- Digital: Minute -->
                                <Grid x:Name="DepthRowMinute"><Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                    <TextBlock Text="Minute" FontSize="14" Foreground="#CCC" VerticalAlignment="Center"
                                        FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"/>
                                    <toolkit:ToggleSwitch x:Name="EdDepthMinute" Grid.Column="1"
                                        Checked="EdDepthLayer_Changed" Unchecked="EdDepthLayer_Changed"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <!-- ══ DISPLAY PROPERTIES ══ -->
                        <StackPanel x:Name="DisplayProps" Visibility="Collapsed">
                            <Button Content="▣ Change Wallpaper" Click="EdWallpaper_Click"
                                Style="{StaticResource EditorActionBtn}" Margin="0,8,0,0"/>
                            <Button Content="✨ AI Wallpaper (Text2Img)" Click="EdAIWallpaper_Click"
                                Style="{StaticResource EditorActionBtn}" Margin="0,8,0,0"/>

                        </StackPanel>

                            <!-- ══ COLOR PROPERTIES ══ -->
                            <StackPanel x:Name="ColorProps" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Border x:Name="ColorScopeClock" Tap="ColorScope_Tap" Tag="Clock" Style="{StaticResource PropOptionPill}" Background="#3A7BF2">
                                        <TextBlock Text="Clock" Style="{StaticResource PropOptionText}" Foreground="White"/>
                                    </Border>
                                    <Border x:Name="ColorScopeSignature" Tap="ColorScope_Tap" Tag="Signature" Style="{StaticResource PropOptionPill}">
                                        <TextBlock Text="Signature" Style="{StaticResource PropOptionText}"/>
                                    </Border>
                                </StackPanel>

                                <!-- Solid Color -->
                                <TextBlock Text="COLOR" Style="{StaticResource PropLabel}"/>
                                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="ColorW" Width="32" Height="32" Fill="White" Stroke="Transparent" StrokeThickness="2" Tap="Color_Tap" Tag="0" Margin="0,0,8,0"/>
                                    <Ellipse x:Name="ColorG" Width="32" Height="32" Fill="#FFD700" Stroke="Transparent" StrokeThickness="2" Tap="Color_Tap" Tag="1" Margin="0,0,8,0"/>
                                    <Ellipse x:Name="ColorB" Width="32" Height="32" Fill="#87CEEB" Stroke="Transparent" StrokeThickness="2" Tap="Color_Tap" Tag="2" Margin="0,0,8,0"/>
                                    <Ellipse x:Name="ColorP" Width="32" Height="32" Fill="#FFB6C1" Stroke="Transparent" StrokeThickness="2" Tap="Color_Tap" Tag="3" Margin="0,0,8,0"/>
                                    <Ellipse x:Name="ColorR" Width="32" Height="32" Fill="#FF4444" Stroke="Transparent" StrokeThickness="2" Tap="Color_Tap" Tag="4" Margin="0,0,8,0"/>
                                    <Ellipse x:Name="ColorMint" Width="32" Height="32" Fill="#5BFFB0" Stroke="Transparent" StrokeThickness="2" Tap="Color_Tap" Tag="5" Margin="0,0,8,0"/>
                                    <Ellipse x:Name="ColorLav" Width="32" Height="32" Fill="#C4A7FF" Stroke="Transparent" StrokeThickness="2" Tap="Color_Tap" Tag="6" Margin="0,0,8,0"/>
                                    <Ellipse x:Name="ColorOr" Width="32" Height="32" Fill="#FF8C42" Stroke="Transparent" StrokeThickness="2" Tap="Color_Tap" Tag="7" Margin="0,0,8,0"/>
                                    <Ellipse x:Name="ColorCy" Width="32" Height="32" Fill="#00E5FF" Stroke="Transparent" StrokeThickness="2" Tap="Color_Tap" Tag="8" Margin="0,0,8,0"/>
                                    <Ellipse x:Name="ColorSi" Width="32" Height="32" Fill="#A0A0B0" Stroke="Transparent" StrokeThickness="2" Tap="Color_Tap" Tag="9" Margin="0,0,0,0"/>
                                </StackPanel>
                                </ScrollViewer>
                                
                                <!-- Gradient -->
                                <TextBlock Text="GRADIENT" Style="{StaticResource PropLabel}"/>
                                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="BlendNone" Tap="Blend_Tap" Tag="0" Style="{StaticResource PropOptionPill}">
                                        <TextBlock Text="None" Style="{StaticResource PropOptionText}"/>
                                    </Border>
                                    <Border x:Name="BlendSunset" Tap="Blend_Tap" Tag="1" Style="{StaticResource PropOptionPill}">
                                        <TextBlock Text="Sunset" Style="{StaticResource PropOptionText}"/>
                                    </Border>
                                    <Border x:Name="BlendOcean" Tap="Blend_Tap" Tag="2" Style="{StaticResource PropOptionPill}">
                                        <TextBlock Text="Ocean" Style="{StaticResource PropOptionText}"/>
                                    </Border>
                                    <Border x:Name="BlendAurora" Tap="Blend_Tap" Tag="3" Style="{StaticResource PropOptionPill}">
                                        <TextBlock Text="Aurora" Style="{StaticResource PropOptionText}"/>
                                    </Border>
                                    <Border x:Name="BlendNeon" Tap="Blend_Tap" Tag="4" Style="{StaticResource PropOptionPill}">
                                        <TextBlock Text="Neon" Style="{StaticResource PropOptionText}"/>
                                    </Border>
                                    <Border x:Name="BlendRose" Tap="Blend_Tap" Tag="5" Style="{StaticResource PropOptionPill}">
                                        <TextBlock Text="Rose" Style="{StaticResource PropOptionText}"/>
                                    </Border>
                                    <Border x:Name="BlendFire" Tap="Blend_Tap" Tag="6" Style="{StaticResource PropOptionPill}">
                                        <TextBlock Text="Fire" Style="{StaticResource PropOptionText}"/>
                                    </Border>
                                    <Border x:Name="BlendIce" Tap="Blend_Tap" Tag="7" Style="{StaticResource PropOptionPill}">
                                        <TextBlock Text="Ice" Style="{StaticResource PropOptionText}"/>
                                    </Border>
                                    <Border x:Name="BlendForest" Tap="Blend_Tap" Tag="8" Style="{StaticResource PropOptionPill}">
                                        <TextBlock Text="Forest" Style="{StaticResource PropOptionText}"/>
                                    </Border>
                                    <Border x:Name="BlendCyber" Tap="Blend_Tap" Tag="9" Style="{StaticResource PropOptionPill}">
                                        <TextBlock Text="Cyber" Style="{StaticResource PropOptionText}"/>
                                    </Border>
                                </StackPanel>
                                </ScrollViewer>
                                
                                <TextBlock Text="OPACITY" Style="{StaticResource PropLabel}" Margin="0,12,0,0"/>
                                <Slider x:Name="EdColorOpacity" Maximum="1.0" Value="1.0" Minimum="0.1" SmallChange="0.05" LargeChange="0.1" ValueChanged="EdColorOpacity_ValueChanged"/>
                                
                                <TextBlock Text="HUE (Custom Color)" Style="{StaticResource PropLabel}"/>
                                <Slider x:Name="EdColorHue" Minimum="-1" Maximum="360" SmallChange="1" LargeChange="10" Value="-1" ValueChanged="EdColorHue_ValueChanged"/>
                            </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        <!-- ═══════════════════════════════════════════════════ -->
        <!--              BOTTOM TOOLBAR (Floating)             -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Grid x:Name="BottomToolbar" VerticalAlignment="Bottom" Height="72" Background="#DD080814">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Margin="10,0" Tap="Toolbar_Widgets_Tap">
                    <Border Width="48" Height="48" CornerRadius="24" Background="#33FFFFFF">
                        <TextBlock Text="&#xE109;" FontFamily="Segoe UI Symbol" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"/>
                    </Border>
                </StackPanel>
                <StackPanel Margin="10,0" Tap="Toolbar_Wallpaper_Tap">
                    <Border Width="48" Height="48" CornerRadius="24" Background="#33FFFFFF">
                        <TextBlock Text="&#xE158;" FontFamily="Segoe UI Symbol" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"/>
                    </Border>
                </StackPanel>
                <StackPanel Margin="10,0" Tap="Toolbar_Filter_Tap">
                    <Border Width="48" Height="48" CornerRadius="24" Background="#33FFFFFF">
                        <TextBlock Text="✨" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"/>
                    </Border>
                </StackPanel>
                <StackPanel Margin="10,0" Tap="Toolbar_Depth_Tap">
                    <Border Width="48" Height="48" CornerRadius="24" Background="#33FFFFFF">
                        <TextBlock Text="🎭" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"/>
                    </Border>
                </StackPanel>
                <StackPanel Margin="10,0" Tap="Toolbar_Color_Tap">
                    <Border Width="48" Height="48" CornerRadius="24" Background="#33FFFFFF">
                        <TextBlock Text="🎨" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ═══ ALIGNMENT GUIDES ═══ -->
        <Rectangle x:Name="GuideV" IsHitTestVisible="False" Width="1"
                   Fill="#66FF4081" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                   Visibility="Collapsed"/>
        <Rectangle x:Name="GuideH" IsHitTestVisible="False" Height="1"
                   Fill="#66FF4081" HorizontalAlignment="Stretch" VerticalAlignment="Top"
                   Visibility="Collapsed"/>

        <!-- ═══ UNSAVED CHANGES DIALOG ═══ -->
        <Grid x:Name="UnsavedDialog" Visibility="Collapsed">
            <!-- Dim background -->
            <Rectangle Fill="#99000000"/>
            <!-- Dialog card -->
            <Border Background="#FF1E1E2E" CornerRadius="16" 
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Width="400" Padding="24,20,24,16">
                <StackPanel>
                    <TextBlock Text="Chưa lưu" FontSize="22" FontWeight="Bold" 
                               Foreground="White" Margin="0,0,0,8"
                               FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"/>
                    <TextBlock Text="Bạn có thay đổi chưa lưu. Bạn muốn làm gì?"
                               FontSize="15" Foreground="#BBFFFFFF" TextWrapping="Wrap"
                               Margin="0,0,0,20"
                               FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Save -->
                        <Border Grid.Column="0" Background="#3A7BF2" CornerRadius="8"
                                Tap="UnsavedDialog_Save" Margin="0,0,4,0" Padding="0,12">
                            <TextBlock Text="Save" HorizontalAlignment="Center"
                                       FontSize="15" Foreground="White" FontWeight="Bold"
                                       FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"/>
                        </Border>
                        <!-- Don't Save -->
                        <Border Grid.Column="1" Background="#33FFFFFF" CornerRadius="8"
                                Tap="UnsavedDialog_DontSave" Margin="2,0,2,0" Padding="0,12">
                            <TextBlock Text="Don't Save" HorizontalAlignment="Center"
                                       FontSize="14" Foreground="#DDFFFFFF"
                                       FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"/>
                        </Border>
                        <!-- Cancel -->
                        <Border Grid.Column="2" Background="#33FFFFFF" CornerRadius="8"
                                Tap="UnsavedDialog_Cancel" Margin="4,0,0,0" Padding="0,12">
                            <TextBlock Text="Cancel" HorizontalAlignment="Center"
                                       FontSize="15" Foreground="#DDFFFFFF"
                                       FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"/>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ AI WALLPAPER DIALOG ═══ -->
        <Grid x:Name="AIPromptDialog" Visibility="Collapsed">
            <Rectangle Fill="#99000000" Tap="AIPromptDialog_Cancel_Tap"/>
            <Border Background="#FF1E1E2E" CornerRadius="16" 
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Width="400" Padding="24,20,24,16">
                <StackPanel>
                    <TextBlock Text="AI Wallpaper" FontSize="22" FontWeight="Bold" 
                               Foreground="White" Margin="0,0,0,8"
                               FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"/>
                    
                    <TextBlock Text="STYLE" FontSize="13" Foreground="#88FFFFFF" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="AIStyleAnime" Grid.Row="0" Grid.Column="0" Tap="AIStyle_Tap" Tag="Anime" Style="{StaticResource PropOptionPill}" Background="#3A7BF2" Margin="0,0,4,4">
                            <TextBlock Text="Anime" Style="{StaticResource PropOptionText}" HorizontalAlignment="Center" Foreground="White"/>
                        </Border>
                        <Border x:Name="AIStyle3D" Grid.Row="0" Grid.Column="1" Tap="AIStyle_Tap" Tag="3D Cartoon" Style="{StaticResource PropOptionPill}" Margin="4,0,0,4">
                            <TextBlock Text="3D Cartoon" Style="{StaticResource PropOptionText}" HorizontalAlignment="Center"/>
                        </Border>
                        <Border x:Name="AIStyleInk" Grid.Row="1" Grid.Column="0" Tap="AIStyle_Tap" Tag="Ink Painting" Style="{StaticResource PropOptionPill}" Margin="0,4,4,0">
                            <TextBlock Text="Ink Painting" Style="{StaticResource PropOptionText}" HorizontalAlignment="Center"/>
                        </Border>
                        <Border x:Name="AIStyleOil" Grid.Row="1" Grid.Column="1" Tap="AIStyle_Tap" Tag="Oil Painting" Style="{StaticResource PropOptionPill}" Margin="4,4,0,0">
                            <TextBlock Text="Oil Painting" Style="{StaticResource PropOptionText}" HorizontalAlignment="Center"/>
                        </Border>
                        <Border x:Name="AIStyleCustom" Grid.Row="2" Grid.ColumnSpan="2" Tap="AIStyle_Tap" Tag="Custom" Style="{StaticResource PropOptionPill}" Margin="0,8,0,0">
                            <TextBlock Text="Custom (Tự do)" Style="{StaticResource PropOptionText}" HorizontalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <TextBlock Text="Custom Prompt (optional):"
                               FontSize="13" Foreground="#BBFFFFFF" TextWrapping="Wrap"
                               Margin="0,0,0,4"
                               FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"/>
                    <TextBox x:Name="AIPromptTextBox" Background="#22FFFFFF" Foreground="White" BorderThickness="0" Margin="0,0,0,20"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Generate -->
                        <Border Grid.Column="0" Background="#3A7BF2" CornerRadius="8"
                                Tap="AIPromptDialog_Generate" Margin="0,0,4,0" Padding="0,12">
                            <TextBlock Text="Generate" HorizontalAlignment="Center"
                                       FontSize="15" Foreground="White" FontWeight="Bold"
                                       FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"/>
                        </Border>
                        <!-- Cancel -->
                        <Border Grid.Column="1" Background="#33FFFFFF" CornerRadius="8"
                                Tap="AIPromptDialog_Cancel" Margin="4,0,0,0" Padding="0,12">
                            <TextBlock Text="Cancel" HorizontalAlignment="Center"
                                       FontSize="15" Foreground="#DDFFFFFF"
                                       FontFamily="/Assets/Fonts/MiSans-Regular.ttf#MiSans"/>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>

</phone:PhoneApplicationPage>
